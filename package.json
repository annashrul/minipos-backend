{
  "name": "menopos-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "dev": "nodemon --watch src --ext ts --exec \"node --enable-source-maps -r @swc-node/register -r tsconfig-paths/register src/main.ts\"",
    "dev:watch": "node --watch --watch-path=src --enable-source-maps -r @swc-node/register -r tsconfig-paths/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:platform-owner": "tsx prisma/seed-platform-owner.ts",
    "db:seed:whatsapp-menu": "tsx prisma/seed-whatsapp-menu.ts",
    "db:seed:modifiers": "tsx prisma/seed-modifiers.ts",
    "db:seed:products": "tsx prisma/seed-products.ts",
    "db:seed:default-coa": "tsx prisma/seed-default-coa.ts",
    "db:backfill:journals:transactions": "tsx prisma/backfill-transaction-journals.ts",
    "db:seed:transactions:2025": "tsx prisma/seed-transactions-2025.ts",
    "db:seed:wholesale": "tsx prisma/seed-wholesale.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.19.2",
    "@prisma/extension-accelerate": "^2.0.2",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "groq-sdk": "^1.1.2",
    "ioredis": "^5.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pusher": "^5.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.32",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.10",
    "@types/passport-jwt": "^4.0.1",
    "nodemon": "^3.1.7",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
