  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([branchId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  description String?
  metadata    String? // JSON
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ===========================
// HUTANG PIUTANG (Debt & Receivable)
// ===========================

model Debt {
  id              String        @id @default(uuid())
  type            DebtType // PAYABLE (hutang - kita berhutang) or RECEIVABLE (piutang - orang lain berhutang ke kita)
  referenceType   String? // "TRANSACTION", "PURCHASE", "OTHER"
  referenceId     String? // linked transaction or purchase order ID
  partyType       String // "CUSTOMER" or "SUPPLIER" or "OTHER"
  partyId         String? // customer or supplier ID
  partyName       String // name for display
  description     String?
  totalAmount     Float // total debt amount
  paidAmount      Float         @default(0) // how much has been paid
  remainingAmount Float // totalAmount - paidAmount
  status          DebtStatus    @default(UNPAID)
  dueDate         DateTime?
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  companyId       String?
  createdBy       String
  creator         User          @relation(fields: [createdBy], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payments        DebtPayment[]
  installments    Installment[]

  // Installment plan config (null = no installment plan)
  downPayment         Float? // DP amount
  installmentCount    Int? // number of installments
  installmentInterval String? // "WEEKLY" or "MONTHLY"

  @@index([type])
  @@index([status])
  @@index([partyId])
  @@index([branchId])
  @@index([createdAt])
  @@index([dueDate])
  @@index([branchId, status])
  @@index([branchId, type, status])
  @@map("debts")
}

model DebtPayment {
  id     String   @id @default(uuid())
  debtId String
  debt   Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount Float
  method String   @default("CASH") // CASH, TRANSFER, etc
  notes  String?
  paidBy String
  payer  User     @relation(fields: [paidBy], references: [id])
  paidAt DateTime @default(now())

  @@index([debtId])
  @@map("debt_payments")
}

model Installment {
  id            String    @id @default(uuid())
  debtId        String
  debt          Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  installmentNo Int // 1, 2, 3, ...
  amount        Float // nominal per cicilan
  dueDate       DateTime // jatuh tempo cicilan ini
  paidAmount    Float     @default(0)
  paidAt        DateTime? // tanggal lunas
  status        String    @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([debtId, installmentNo])
  @@index([debtId])
  @@index([dueDate])
  @@index([status])
  @@map("installments")
}

enum DebtType {
  PAYABLE // Hutang (kita berhutang ke supplier/orang lain)
  RECEIVABLE // Piutang (customer/orang lain berhutang ke kita)
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

// ===========================
// APPROVAL WORKFLOW
// ===========================

model ApprovalRequest {
  id            String   @id @default(uuid())
  type          String // "VOID", "REFUND", "LARGE_DISCOUNT", "PRICE_OVERRIDE"
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  requestedBy   String
  requester     User     @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  approvedBy    String?
  approver      User?    @relation("ApprovalApprover", fields: [approvedBy], references: [id])
  referenceId   String? // transaction ID, etc
  details       String? // JSON with context data
  reason        String?
  rejectionNote String?
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([requestedBy])
  @@index([branchId])
  @@index([branchId, status, createdAt])
  @@map("approval_requests")
}

// ===========================
// STORE CREDIT / GIFT CARD
// ===========================

model StoreCredit {
  id            String             @id @default(uuid())
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id])
  code          String             @unique // gift card code
  balance       Float              @default(0)
  initialAmount Float
  isActive      Boolean            @default(true)
  expiryDate    DateTime?
  issuedBy      String
  issuer        User               @relation(fields: [issuedBy], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  usages        StoreCreditUsage[]

  @@index([customerId])
  @@index([code])
  @@map("store_credits")
}

model StoreCreditUsage {
  id            String      @id @default(uuid())
  storeCreditId String
  storeCredit   StoreCredit @relation(fields: [storeCreditId], references: [id])
  amount        Float
  transactionId String?
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([storeCreditId])
  @@map("store_credit_usages")
}

// ===========================
// RETURN & EXCHANGE
// ===========================

model ReturnExchange {
  id              String               @id @default(uuid())
  returnNumber    String               @unique
  transactionId   String
  transaction     Transaction          @relation(fields: [transactionId], references: [id])
  customerId      String?
  customer        Customer?            @relation(fields: [customerId], references: [id])
  type            String // RETURN, EXCHANGE
  status          String               @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  reason          String
  notes           String?
  totalRefund     Float                @default(0)
  refundMethod    String? // CASH, STORE_CREDIT, ORIGINAL_METHOD
  approvedBy      String?
  approvedAt      DateTime?
  branchId        String?
  branch          Branch?              @relation(fields: [branchId], references: [id])
  processedBy     String
  processedByUser User                 @relation("ReturnProcessedBy", fields: [processedBy], references: [id])
  items           ReturnExchangeItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([transactionId])
  @@index([returnNumber])
  @@map("return_exchanges")
}

model ReturnExchangeItem {
  id                String         @id @default(uuid())
  returnExchangeId  String
  returnExchange    ReturnExchange @relation(fields: [returnExchangeId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  productName       String
  quantity          Int
  unitPrice         Float
  subtotal          Float
  reason            String?
  // For exchange: replacement product
  exchangeProductId String?
  exchangeProduct   Product?       @relation("ExchangeProduct", fields: [exchangeProductId], references: [id])
  exchangeQuantity  Int?
  restocked         Boolean        @default(false)

  @@index([returnExchangeId])
  @@map("return_exchange_items")
}

// ===========================
// GIFT CARDS
// ===========================

model GiftCard {
  id             String                @id @default(uuid())
  code           String                @unique
  initialBalance Float
  currentBalance Float
  status         String                @default("ACTIVE") // ACTIVE, USED, EXPIRED, DISABLED
  purchasedBy    String? // customer name or walk-in
  customerId     String?
  customer       Customer?             @relation(fields: [customerId], references: [id])
  expiresAt      DateTime?
  companyId      String?
  branchId       String?
  branch         Branch?               @relation(fields: [branchId], references: [id])
  createdBy      String
  createdByUser  User                  @relation("GiftCardCreatedBy", fields: [createdBy], references: [id])
  transactions   GiftCardTransaction[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([code])
  @@index([companyId])
  @@index([customerId])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id            String   @id @default(uuid())
  giftCardId    String
  giftCard      GiftCard @relation(fields: [giftCardId], references: [id])
  type          String // PURCHASE, REDEEM, TOPUP, REFUND
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reference     String? // invoice number or note
  createdAt     DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_transactions")
}

// ===========================
// SALES TARGET & GAMIFICATION
// ===========================

model SalesTarget {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  type          String // DAILY, WEEKLY, MONTHLY
  targetRevenue Float?
  targetTx      Int? // target transaction count
  targetItems   Int? // target items sold
  period        String // e.g. "2026-04", "2026-W14", "2026-04-04"
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, type, period])
  @@index([period])
  @@map("sales_targets")
}

model CashierBadge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  badge       String // TOP_SELLER, ZERO_VOID, SPEED_DEMON, STREAK_7, etc.
  title       String
  description String?
  earnedAt    DateTime @default(now())
  period      String? // period when earned

  @@index([userId])
  @@map("cashier_badges")
}

// ===========================
// PRICE SCHEDULER
// ===========================

model PriceSchedule {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  companyId     String?
  newPrice      Float
  originalPrice Float
  startDate     DateTime
  endDate       DateTime
  reason        String?
  isActive      Boolean   @default(true)
  appliedAt     DateTime?
  revertedAt    DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())

  @@index([productId])
  @@index([startDate, endDate])
  @@map("price_schedules")
}

// ===========================
// EMPLOYEE SCHEDULER
// ===========================

model EmployeeSchedule {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  date       DateTime @db.Date
  shiftStart String // "08:00"
  shiftEnd   String // "16:00"
  shiftLabel String? // "Pagi", "Siang", "Malam"
  status     String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, ABSENT, LEAVE
  notes      String?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([branchId, date])
  @@map("employee_schedules")
}

// ===========================
// KITCHEN / ORDER DISPLAY
// ===========================

model OrderQueue {
  id            String           @id @default(uuid())
  queueNumber   Int
  transactionId String?
  transaction   Transaction?     @relation(fields: [transactionId], references: [id])
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id])
  status        String           @default("NEW") // NEW, PREPARING, READY, SERVED, CANCELLED
  priority      Int              @default(0)
  notes         String?
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  items         OrderQueueItem[]
  tableOrders   TableOrder[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  servedAt      DateTime?

  @@index([branchId, status])
  @@index([createdAt])
  @@map("order_queues")
}

model OrderQueueItem {
  id           String     @id @default(uuid())
  orderQueueId String
  orderQueue   OrderQueue @relation(fields: [orderQueueId], references: [id], onDelete: Cascade)
  productName  String
  quantity     Int
  notes        String?
  status       String     @default("PENDING") // PENDING, PREPARING, DONE

  @@index([orderQueueId])
  @@map("order_queue_items")
}

// ===========================
// CASHIER FAVORITES (POS Quick Access)
// ===========================

model CashierFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("cashier_favorites")
}

// ===========================
// ACCOUNTING MODULE
// ===========================

model AccountCategory {
  id         String    @id @default(uuid())
  name       String // Aset, Kewajiban, Modal, Pendapatan, Beban
  type       String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  normalSide String // DEBIT, CREDIT
  sortOrder  Int       @default(0)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  accounts   Account[]
  createdAt  DateTime  @default(now())

  @@unique([companyId, type])
  @@index([companyId])
  @@map("account_categories")
}

model Account {
  id                  String                 @id @default(uuid())
  code                String // e.g. 1-1001
  name                String
  description         String?
  categoryId          String
  category            AccountCategory        @relation(fields: [categoryId], references: [id])
  parentId            String?
  parent              Account?               @relation("AccountHierarchy", fields: [parentId], references: [id])
  children            Account[]              @relation("AccountHierarchy")
  isActive            Boolean                @default(true)
  isSystem            Boolean                @default(false) // System accounts can't be deleted
  branchId            String? // null = global account
  branch              Branch?                @relation(fields: [branchId], references: [id])
  openingBalance      Float                  @default(0)
  journalLines        JournalEntryLine[]
  taxConfigs          TaxConfig[]
  recurringLines      RecurringJournalLine[]
  bankReconciliations BankReconciliation[]   @relation("BankReconAccount")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([categoryId])
  @@index([parentId])
  @@index([code])
  @@index([branchId])
  @@map("accounts")
}

model JournalEntry {
  id             String             @id @default(uuid())
  entryNumber    String             @unique // JV-260404-0001
  date           DateTime           @db.Date
  description    String
  reference      String? // invoice number, PO number, etc.
  referenceType  String? // TRANSACTION, PURCHASE, RETURN, DEBT_PAYMENT, EXPENSE, MANUAL
  referenceId    String? // ID of related entity
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  periodId       String?
  period         AccountingPeriod?  @relation(fields: [periodId], references: [id])
  status         String             @default("POSTED") // DRAFT, PENDING_APPROVAL, POSTED, VOIDED
  totalDebit     Float              @default(0)
  totalCredit    Float              @default(0)
  lines          JournalEntryLine[]
  createdBy      String
  createdByUser  User               @relation("JournalCreatedBy", fields: [createdBy], references: [id])
  approvedBy     String?
  approvedByUser User?              @relation("JournalApprovedBy", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  rejectionNote  String?
  updatedBy      String?
  notes          String?
  changeLogs     JournalChangeLog[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([date])
  @@index([entryNumber])
  @@index([referenceType, referenceId])
  @@index([branchId])
  @@index([periodId])
  @@index([status])
  @@index([status, date])
  @@index([branchId, status, date, createdAt])
  @@map("journal_entries")
}

model JournalEntryLine {
  id            String       @id @default(uuid())
  journalId     String
  journal       JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  description   String?
  debit         Float        @default(0)
  credit        Float        @default(0)
  taxType       String? // PPN_KELUARAN, PPN_MASUKAN, PPH21, PPH23
  taxAmount     Float?       @default(0)
  taxBaseAmount Float?       @default(0) // DPP (Dasar Pengenaan Pajak)
  sortOrder     Int          @default(0)

  @@index([journalId])
  @@index([accountId])
  @@index([journalId, sortOrder])
  @@index([accountId, journalId])
  @@map("journal_entry_lines")
}

model AccountingPeriod {
  id        String         @id @default(uuid())
  name      String // "April 2026"
  startDate DateTime       @db.Date
  endDate   DateTime       @db.Date
  status    String         @default("OPEN") // OPEN, CLOSED, LOCKED
  closedBy  String?
  closedAt  DateTime?
  companyId String?
  journals  JournalEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([startDate, endDate, companyId])
  @@index([status])
  @@index([companyId])
  @@map("accounting_periods")
}

model TaxConfig {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  taxType   String // PPN, PPH21, PPH23, PPH_FINAL
  name      String // "PPN 11%", "PPh 23 - 2%"
  rate      Float // 0.11, 0.02
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, taxType])
  @@index([companyId])
  @@map("tax_configs")
}

model JournalChangeLog {
  id        String       @id @default(uuid())
  journalId String
  journal   JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  action    String // CREATED, UPDATED, SUBMITTED, APPROVED, REJECTED, POSTED, VOIDED
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  changes   String? // JSON: { field: { old, new } }
  snapshot  String? // JSON: full journal state at time of action
  ipAddress String?
  createdAt DateTime     @default(now())

  @@index([journalId])
  @@index([userId])
  @@index([createdAt])
  @@map("journal_change_logs")
}

model RecurringJournalTemplate {
  id            String                 @id @default(uuid())
  name          String
  description   String?
  frequency     String // MONTHLY, QUARTERLY, YEARLY
  dayOfMonth    Int?                   @default(1)
  nextRunDate   DateTime               @db.Date
  lastRunDate   DateTime?              @db.Date
  isActive      Boolean                @default(true)
  branchId      String?
  branch        Branch?                @relation(fields: [branchId], references: [id])
  companyId     String
  company       Company                @relation(fields: [companyId], references: [id])
  createdBy     String
  createdByUser User                   @relation(fields: [createdBy], references: [id])
  lines         RecurringJournalLine[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([companyId, isActive])
  @@index([nextRunDate])
  @@map("recurring_journal_templates")
}

model RecurringJournalLine {
  id          String                   @id @default(uuid())
  templateId  String
  template    RecurringJournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account                  @relation(fields: [accountId], references: [id])
  description String?
  debit       Float                    @default(0)
  credit      Float                    @default(0)
  sortOrder   Int                      @default(0)

  @@index([templateId])
  @@map("recurring_journal_lines")
}

model BankReconciliation {
  id               String                   @id @default(uuid())
  accountId        String
  account          Account                  @relation("BankReconAccount", fields: [accountId], references: [id])
  statementDate    DateTime                 @db.Date
  statementBalance Float
  bookBalance      Float                    @default(0)
  status           String                   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  companyId        String
  company          Company                  @relation(fields: [companyId], references: [id])
  completedBy      String?
  completedAt      DateTime?
  items            BankReconciliationItem[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([companyId])
  @@index([accountId, statementDate])
  @@map("bank_reconciliations")
}

model BankReconciliationItem {
  id               String             @id @default(uuid())
  reconciliationId String
  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  source           String // BANK_STATEMENT, JOURNAL
  referenceNumber  String?
  description      String
  date             DateTime           @db.Date
  amount           Float
  matchedItemId    String?
  matchStatus      String             @default("UNMATCHED") // UNMATCHED, MATCHED, ADJUSTED
  journalEntryId   String?
  createdAt        DateTime           @default(now())

  @@index([reconciliationId])
  @@index([matchStatus])
  @@map("bank_reconciliation_items")
}

// ===========================
// RECIPES (BOM untuk F&B)
// ===========================
//
// Konsep: satu Product (mis. menu "Nasi Goreng") punya 1 Recipe yg merangkai
// daftar ingredient (Product lain yg di-stock sebagai bahan baku — beras,
// telur, ayam, dst). Saat menu tsb dijual, transaction service expand recipe
// → decrement stok bahan baku, bukan stok menu. Cocok untuk restoran/cafe
// di mana stok menu sebenarnya = ketersediaan bahan-bahan-nya.
//
// `yieldQty` = berapa porsi dihasilkan dari 1 batch resep. Default 1 (1
// resep = 1 porsi). Kalau resep "kuah soto 1 panci = 8 porsi", set 8 — qty
// ingredient akan dibagi yieldQty saat decrement.

model Recipe {
  id          String             @id @default(uuid())
  productId   String             @unique
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  yieldQty    Float              @default(1)
  notes       String?
  ingredients RecipeIngredient[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("recipes")
}

model RecipeIngredient {
  id           String   @id @default(uuid())
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Product  @relation("RecipeIngredient", fields: [ingredientId], references: [id])
  quantity     Float
  unit         String   @default("pcs")
  notes        String?
  createdAt    DateTime @default(now())

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

// ===========================
// PRODUCT BUNDLES
// ===========================

model ProductBundle {
  id             String              @id @default(uuid())
  code           String              @unique
  name           String
  description    String?
  imageUrl       String?
  sellingPrice   Float // Bundle price (usually discounted)
  totalBasePrice Float               @default(0) // Sum of component prices (for margin calculation)
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id])
  isActive       Boolean             @default(true)
  barcode        String?             @unique
  items          ProductBundleItem[]
  companyId      String?
  branchId       String?
  branch         Branch?             @relation(fields: [branchId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([isActive])
  @@index([categoryId])
  @@index([companyId])
  @@index([branchId])
  @@map("product_bundles")
}

model ProductBundleItem {
  id        String        @id @default(uuid())
  bundleId  String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int           @default(1)
  sortOrder Int           @default(0)

  @@index([bundleId])
  @@index([productId])
  @@map("product_bundle_items")
}

// ===========================
// RESTAURANT TABLES
// ===========================

model RestaurantTable {
  id        String   @id @default(uuid())
  number    Int
  name      String? // e.g. "Meja VIP 1", "Outdoor 3"
  capacity  Int      @default(4)
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  section   String? // e.g. "Indoor", "Outdoor", "VIP"
  qrToken   String?  @unique // public token for tablet ordering URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  orderQueues   OrderQueue[]
  tableSessions TableSession[]
  tableOrders   TableOrder[]
  bookings      Booking[]

  @@unique([number, branchId])
  @@index([branchId, status])
  @@index([section])
  @@map("restaurant_tables")
}

// ===========================
// SELF-ORDER (Table Tablet Ordering)
// ===========================
//
// One open TableSession per table groups multiple TableOrder submissions
// into a single bill. Customer can keep ordering while session is OPEN.
// Session is closed when payment is settled (online or via kasir) OR
// when kasir manually closes it.

model TableSession {
  id            String          @id @default(uuid())
  tableId       String
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  status        String          @default("OPEN") // OPEN, AWAITING_PAYMENT, CLOSED
  customerName  String?
  customerPhone String?
  subtotal      Float           @default(0)
  paidAmount    Float           @default(0)
  transactionId String?         @unique
  transaction   Transaction?    @relation(fields: [transactionId], references: [id])
  openedAt      DateTime        @default(now())
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  orders   TableOrder[]
  payments TableSessionPayment[]

  @@index([branchId, status])
  @@index([tableId, status])
  @@map("table_sessions")
}

model TableOrder {
  id             String          @id @default(uuid())
  sessionId      String
  session        TableSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tableId        String
  table          RestaurantTable @relation(fields: [tableId], references: [id])
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  status         String          @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, SENT_TO_KITCHEN, READY, SERVED, CANCELLED
  total          Float           @default(0)
  customerNote   String?
  rejectReason   String?
  approvedBy     String?
  approvedByUser User?           @relation(fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  orderQueueId   String? // link to KDS queue once approved
  orderQueue     OrderQueue?     @relation(fields: [orderQueueId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items TableOrderItem[]

  @@index([branchId, status])
  @@index([sessionId])
  @@index([tableId, status])
  @@index([createdAt])
  @@map("table_orders")
}

model TableOrderItem {
  id          String     @id @default(uuid())
  orderId     String
  order       TableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  productName String // snapshot at time of order
  qty         Int
  unitPrice   Float
  subtotal    Float
  note        String?

  @@index([orderId])
  @@index([productId])
  @@map("table_order_items")
}

// Foundation for online payments. Provider implementations come later;
// service code only writes generic fields here.
model TableSessionPayment {
  id         String       @id @default(uuid())
  sessionId  String
  session    TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  provider   String // QRIS, MIDTRANS, XENDIT, MANUAL
  channel    String? // e.g. GOPAY, OVO, BANK_TRANSFER
  amount     Float
  status     String       @default("PENDING") // PENDING, PAID, FAILED, EXPIRED, REFUNDED
  externalId String? // gateway transaction reference
  rawPayload Json? // gateway-specific payload
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([sessionId])
  @@index([provider, externalId])
  @@map("table_session_payments")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("email_verification_tokens")
}

model PhoneVerificationToken {
  id        String   @id @default(uuid())
  phone     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([token])
  @@map("phone_verification_tokens")
}

model SubscriptionPayment {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  plan           String // PRO, ENTERPRISE
  amount         Float
  durationMonths Int
  billingType    String    @default("MONTHLY") // MONTHLY, YEARLY
  status         String    @default("PAID") // PAID, PENDING, REFUNDED, CANCELLED
  planStartDate  DateTime
  planEndDate    DateTime
  notes          String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([companyId])
  @@index([status])
  @@map("subscription_payments")
}

model PlanMenuAccess {
  id      String  @id @default(uuid())
  plan    String // FREE, PRO, ENTERPRISE
  menuKey String // references AppMenu.key
  allowed Boolean @default(false)

  @@unique([plan, menuKey])
  @@index([plan])
  @@map("plan_menu_access")
}

model PlanActionAccess {
  id        String  @id @default(uuid())
  plan      String // FREE, PRO, ENTERPRISE
  menuKey   String
  actionKey String
  allowed   Boolean @default(false)

  @@unique([plan, menuKey, actionKey])
  @@index([plan])
  @@map("plan_action_access")
}

model PaymentOrder {
  id             String              @id @default(uuid())
  companyId      String
  transactionId  String?
  transaction    Transaction?        @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  provider       String              @default("xendit")
  // ID yang kita kirim ke Xendit sebagai external_id (unik global).
  externalId     String              @unique
  // ID dari sisi Xendit (dari response create) — disimpan saat tahu.
  providerOrderId String?
  status         PaymentOrderStatus  @default(PENDING)
  amount         Int
  currency       String              @default("IDR")
  description    String?
  payerEmail     String?
  paymentUrl     String?
  // Method final yang dipilih customer di halaman Xendit (BCA/QRIS/OVO/dst).
  paymentMethod  String?
  paymentChannel String?
  paidAt         DateTime?
  expiresAt      DateTime?
  failureReason  String?
  rawCreate      Json?
  rawCallback    Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([companyId])
  @@index([transactionId])
  @@index([status])
  @@index([provider, providerOrderId])
  @@map("payment_orders")
}
