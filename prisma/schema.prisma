}

model CashMovement {
  id        String           @id @default(uuid())
  shiftId   String
  shift     CashierShift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      CashMovementType
  amount    Float
  reason    String
  reference String?
  createdAt DateTime         @default(now())

  @@index([shiftId])
  @@map("cash_movements")
}

