  isUsed      Boolean   @default(false)
  usedBy      String?
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([code])
  @@index([promotionId])
  @@map("vouchers")
}

