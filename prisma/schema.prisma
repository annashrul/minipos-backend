generator client {
  provider      = "prisma-client-js"
  // native = builder OS (debian); linux-musl = runtime alpine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================
// ENUMS
// ===========================

// Role enum kept for type reference / seed - actual field uses String
enum Role {
  PLATFORM_OWNER
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
}

model AppRole {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "SUPER_ADMIN", "CUSTOM_SALES"
  name        String // Display name
  description String?
  color       String? // Tailwind color class
  isSystem    Boolean  @default(false) // System roles can't be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("app_roles")
}

enum StockMovementType {
  // Legacy (data lama sebelum ledger refactor)
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  OPNAME
  // Granular — service ledger pakai ini sejak refactor
  PURCHASE_RECEIVE
  SALE
  RETURN_IN
  RETURN_OUT
  TRANSFER_OUT
  TRANSFER_IN
  OPNAME_ADJUSTMENT
  WASTE
  RECIPE_DEDUCT
  MANUAL_IN
  MANUAL_OUT
  RTV
}

enum TransactionStatus {
  COMPLETED
  PENDING
  HELD
  VOIDED
  REFUNDED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  EWALLET
  DEBIT
  CREDIT_CARD
  TERMIN
}

enum MemberLevel {
  REGULAR
  SILVER
  GOLD
  PLATINUM
}

enum PromoType {
  DISCOUNT_PERCENT
  DISCOUNT_AMOUNT
  BUY_X_GET_Y
  VOUCHER
  BUNDLE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CLOSED
  CANCELLED
}

enum StockOpnameStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
  REJECTED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

// ===========================
// CORE
// ===========================

model Company {
  id                   String                     @id @default(uuid())
  name                 String
  slug                 String                     @unique // URL-friendly identifier
  address              String?
  phone                String?
  email                String?
  logo                 String?
  plan                 String                     @default("FREE") // FREE, PRO, ENTERPRISE
  // Jenis usaha — drive ketersediaan menu di sidebar.
  // RETAIL, BENGKEL, RESTAURANT, CAFE.
  businessUnit         String                     @default("RETAIL") @map("business_unit")
  planExpiresAt        DateTime?
  isActive             Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  users                User[]
  branches             Branch[]
  categories           Category[]
  brands               Brand[]
  products             Product[]
  suppliers            Supplier[]
  customers            Customer[]
  promotions           Promotion[]
  accountCategories    AccountCategory[]
  subscriptionPayments SubscriptionPayment[]
  taxConfigs           TaxConfig[]
  recurringTemplates   RecurringJournalTemplate[]
  bankReconciliations  BankReconciliation[]
  modifierGroups       ModifierGroup[]
  whatsappSession      WhatsappSession?

  @@index([slug])
  @@map("companies")
}

model User {
  id                  String                     @id @default(uuid())
  name                String
  email               String                     @unique
  phone               String?
  password            String
  role                String                     @default("CASHIER")
  // Bengkel: User dengan flag ini bisa di-assign sebagai mekanik di
  // ServiceOrder & ServiceOrderItem (untuk komisi/payroll).
  isMechanic          Boolean                    @default(false) @map("is_mechanic")
  companyId           String?
  company             Company?                   @relation(fields: [companyId], references: [id])
  branchId            String?
  branch              Branch?                    @relation(fields: [branchId], references: [id])
  isActive            Boolean                    @default(true)
  emailVerified       Boolean                    @default(false)
  phoneVerified       Boolean                    @default(false)
  deletedAt           DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  transactions        Transaction[]
  auditLogs           AuditLog[]
  activityLogs        ActivityLog[]
  cashierShifts       CashierShift[]
  debtsCreated        Debt[]
  debtPayments        DebtPayment[]
  approvalRequests    ApprovalRequest[]          @relation("ApprovalRequester")
  approvalDecisions   ApprovalRequest[]          @relation("ApprovalApprover")
  storeCreditsIssued  StoreCredit[]
  returnsProcessed    ReturnExchange[]           @relation("ReturnProcessedBy")
  giftCardsCreated    GiftCard[]                 @relation("GiftCardCreatedBy")
  salesTargets        SalesTarget[]
  badges              CashierBadge[]
  schedules           EmployeeSchedule[]
  favorites           CashierFavorite[]
  journalsCreated     JournalEntry[]             @relation("JournalCreatedBy")
  journalsApproved    JournalEntry[]             @relation("JournalApprovedBy")
  journalChangeLogs   JournalChangeLog[]
  recurringTemplates  RecurringJournalTemplate[]
  tableOrdersApproved TableOrder[]
  serviceOrdersAsMechanic ServiceOrder[]         @relation("ServiceOrderMechanic")
  serviceOrderItems       ServiceOrderItem[]    @relation("ServiceOrderItemMechanic")
  bookingsAsMechanic      Booking[]              @relation("BookingMechanic")
  bookingsCreated         Booking[]              @relation("BookingCreatedBy")

  @@index([email])
  @@index([role])
  @@index([companyId])
  @@index([branchId])
  @@index([isMechanic])
  @@map("users")
}

model AppMenu {
  id        String               @id @default(uuid())
  key       String               @unique
  name      String
  path      String               @unique
  group     String
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  // Daftar business unit yang bisa lihat menu ini (mis. ["BENGKEL"] berarti
  // hanya company businessUnit=BENGKEL). NULL atau empty = available untuk
  // semua. Default null supaya semua menu existing tetap visible.
  businessUnits Json?            @map("business_units")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  actions   MenuAction[]
  roleMenus RoleMenuPermission[]

  @@index([group])
  @@index([sortOrder])
  @@index([isActive])
  @@map("app_menus")
}

model MenuAction {
  id          String                 @id @default(uuid())
  menuId      String
  menu        AppMenu                @relation(fields: [menuId], references: [id], onDelete: Cascade)
  key         String
  name        String
  sortOrder   Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  roleActions RoleActionPermission[]

  @@unique([menuId, key])
  @@index([menuId])
  @@index([sortOrder])
  @@index([isActive])
  @@map("menu_actions")
}

model RoleMenuPermission {
  id        String   @id @default(uuid())
  role      String
  menuId    String
  menu      AppMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, menuId])
  @@index([role])
  @@index([menuId])
  @@map("role_menu_permissions")
}

model RoleActionPermission {
  id           String     @id @default(uuid())
  role         String
  menuActionId String
  menuAction   MenuAction @relation(fields: [menuActionId], references: [id], onDelete: Cascade)
  allowed      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([role, menuActionId])
  @@index([role])
  @@index([menuActionId])
  @@map("role_action_permissions")
}

model Branch {
  id                 String                     @id @default(uuid())
  name               String
  code               String?
  address            String?
  phone              String?
  latitude           Float?
  longitude          Float?
  companyId          String
  company            Company                    @relation(fields: [companyId], references: [id])
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  users              User[]
  stockTransfersFrom StockTransfer[]            @relation("TransferFrom")
  stockTransfersTo   StockTransfer[]            @relation("TransferTo")
  stockOpnames       StockOpname[]
  productPrices      BranchProductPrice[]
  branchStocks       BranchStock[]
  stockMovements     StockMovement[]
  transactions       Transaction[]
  purchaseOrders     PurchaseOrder[]
  cashierShifts      CashierShift[]
  expenses           Expense[]
  auditLogs          AuditLog[]
  settings           Setting[]
  debts              Debt[]
  approvalRequests   ApprovalRequest[]
  returnExchanges    ReturnExchange[]
  giftCards          GiftCard[]
  salesTargets       SalesTarget[]
  priceSchedules     PriceSchedule[]
  employeeSchedules  EmployeeSchedule[]
  orderQueues        OrderQueue[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  restaurantTables   RestaurantTable[]
  productBundles     ProductBundle[]
  promotions         Promotion[]
  closingReports     ClosingReport[]
  goodsReceipts      GoodsReceipt[]
  recurringTemplates RecurringJournalTemplate[]
  tableSessions      TableSession[]
  tableOrders        TableOrder[]
  serviceOrders      ServiceOrder[]
  bookings           Booking[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model BranchProductPrice {
  id            String   @id @default(uuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellingPrice  Float
  purchasePrice Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_product_prices")
}

model BranchStock {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  minStock  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_stocks")
}

// ===========================
// PRODUK
// ===========================

model Category {
  id          String          @id @default(uuid())
  name        String
  description String?
  parentId    String?
  parent      Category?       @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[]      @relation("SubCategories")
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  // PRODUCT (default, kategori produk) atau VEHICLE_MODEL (model kendaraan
  // bengkel — relate ke brand kendaraan).
  kind        String          @default("PRODUCT")
  // Untuk VEHICLE_MODEL: relasi ke Brand (mis. model "Vario 150" milik
  // brand "Honda"). Null untuk kategori produk biasa.
  brandId     String?
  brand       Brand?          @relation("CategoryBrand", fields: [brandId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  products    Product[]
  promotions  Promotion[]
  bundles     ProductBundle[]
  vehicles    Vehicle[]       @relation("VehicleModel")

  @@unique([companyId, name])
  @@index([parentId])
  @@index([companyId])
  @@index([kind])
  @@index([brandId])
  @@map("categories")
}

model Brand {
  id          String     @id @default(uuid())
  name        String
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  // PRODUCT (default) atau VEHICLE — Honda, Toyota, dll untuk bengkel.
  kind        String     @default("PRODUCT")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  models      Category[] @relation("CategoryBrand")
  vehicles    Vehicle[]  @relation("VehicleBrand")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([kind])
  @@map("brands")
}

model Product {
  id                 String                 @id @default(uuid())
  code               String
  name               String
  categoryId         String
  category           Category               @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?                 @relation(fields: [brandId], references: [id])
  supplierId         String?
  supplier           Supplier?              @relation(fields: [supplierId], references: [id])
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id])
  purchasePrice      Float
  sellingPrice       Float
  stock              Int                    @default(0)
  minStock           Int                    @default(5)
  barcode            String?
  unit               String                 @default("pcs")
  // PRODUCT = barang fisik dengan stock; SERVICE = jasa (no stock validation,
  // skip stock movement, dipakai bisnis bengkel/jasa). Default PRODUCT supaya
  // backward-compat.
  itemType           String                 @default("PRODUCT") @map("item_type")
  isActive           Boolean                @default(true)
  description        String?
  imageUrl           String?
  expiryDate         DateTime?
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  barcodes           ProductBarcode[]
  priceHistories     ProductPriceHistory[]
  transactionItems   TransactionItem[]
  stockMovements     StockMovement[]
  promotions         Promotion[]
  purchaseOrderItems PurchaseOrderItem[]
  stockOpnameItems   StockOpnameItem[]
  branchPrices       BranchProductPrice[]
  branchStocks       BranchStock[]
  units              ProductUnit[]
  tierPrices         ProductTierPrice[]
  returnItems        ReturnExchangeItem[]
  exchangeItems      ReturnExchangeItem[]   @relation("ExchangeProduct")
  priceSchedules     PriceSchedule[]
  cashierFavorites   CashierFavorite[]
  bundleItems        ProductBundleItem[]
  modifierGroups     ProductModifierGroup[]
  tableOrderItems    TableOrderItem[]
  recipe             Recipe?
  usedInRecipes      RecipeIngredient[]     @relation("RecipeIngredient")

  @@unique([companyId, code])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([barcode])
  @@index([name])
  @@index([isActive, stock])
  @@map("products")
}

model ProductBarcode {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode   String   @unique
  label     String?
  createdAt DateTime @default(now())

  @@index([barcode])
  @@index([productId])
  @@map("product_barcodes")
}

model ProductPriceHistory {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldBuyPrice  Float
  newBuyPrice  Float
  oldSellPrice Float
  newSellPrice Float
  changedBy    String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@map("product_price_histories")
}

model ProductUnit {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // e.g. "Box", "Bungkus", "Batang"
  conversionQty Int // how many base units in 1 of this unit (Batang=1, Bungkus=16, Box=192)
  sellingPrice  Float // selling price for this unit
  purchasePrice Float? // purchase price for this unit (optional)
  barcode       String? // optional barcode for this unit
  isDefault     Boolean  @default(false) // is this the default selling unit?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@index([barcode])
  @@map("product_units")
}

model ProductTierPrice {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, minQty])
  @@index([productId])
  @@index([minQty])
  @@map("product_tier_prices")
}

// ===========================
// SUPPLIER
// ===========================

model Supplier {
  id               String            @id @default(uuid())
  name             String
  contact          String?
  address          String?
  email            String?
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]

  @@index([companyId])
  @@map("suppliers")
}

model SupplierPayment {
  id         String        @id @default(uuid())
  supplierId String
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  poId       String?
  amount     Float
  method     PaymentMethod @default(TRANSFER)
  reference  String?
  notes      String?
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([supplierId])
  @@index([paidAt])
  @@map("supplier_payments")
}

// ===========================
// CUSTOMER
// ===========================

model Customer {
  id             String                 @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  memberLevel    MemberLevel            @default(REGULAR)
  totalSpending  Float                  @default(0)
  points         Int                    @default(0)
  memberCardCode String?
  dateOfBirth    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   Transaction[]
  pointHistories CustomerPointHistory[]
  storeCredits   StoreCredit[]
  returns        ReturnExchange[]
  giftCards      GiftCard[]
  vehicles       Vehicle[]
  serviceOrders  ServiceOrder[]
  bookings       Booking[]

  @@unique([companyId, phone])
  @@unique([companyId, memberCardCode])
  @@index([companyId])
  @@index([phone])
  @@index([memberCardCode])
  @@index([memberLevel])
  @@map("customers")
}

model CustomerPointHistory {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points      Int
  type        String // EARN, REDEEM, EXPIRED, ADJUST
  reference   String? // invoice number or reason
  description String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_point_histories")
}

// ===========================
// TRANSAKSI
// ===========================

model Transaction {
  id             String            @id @default(uuid())
  // Global-unique invoice — composite "{COMPANY_SLUG}-{BRANCH_CODE}-{RAND}".
  // Tetap dipakai sebagai authoritative ID lintas system (export, audit log).
  invoiceNumber  String            @unique
  // Display invoice — readable per company per hari, format
  // "INV-DDMMYYYY-NNNNN" (NNNNN sequential per companyId per date).
  // Nullable utk row legacy sebelum kolom ini dibuat.
  invoiceDisplayNumber String?
  // Denormalized companyId (sumber: user.companyId) supaya unique constraint
  // (companyId, invoiceDisplayNumber) bisa dipasang langsung.
  companyId      String?
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  branchId       String?
  branch         Branch?           @relation(fields: [branchId], references: [id])
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id])
  subtotal       Float
  discountAmount Float             @default(0)
  taxAmount      Float             @default(0)
  grandTotal     Float
  paymentMethod  PaymentMethod     @default(CASH)
  paymentAmount  Float
  changeAmount   Float             @default(0)
  status         TransactionStatus @default(COMPLETED)
  voidReason     String?
  promoApplied   String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          TransactionItem[]
  payments       Payment[]
  refund         Refund?
  returns        ReturnExchange[]
  orderQueues    OrderQueue[]
  paymentOrders  PaymentOrder[]
  tableId        String?
  table          RestaurantTable?  @relation(fields: [tableId], references: [id])
  tableSession   TableSession?
  // Bengkel: Transaction yang berasal dari finalize ServiceOrder.
  serviceOrder   ServiceOrder?     @relation("ServiceOrderTransaction")

  @@unique([companyId, invoiceDisplayNumber])
  @@index([invoiceNumber])
  @@index([userId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
  @@index([branchId, status, createdAt])
  @@index([companyId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  productName   String
  productCode   String
  quantity      Int
  unitName      String      @default("PCS")
  conversionQty Int         @default(1)
  baseQty       Int?
  unitPrice     Float
  discount      Float       @default(0)
  subtotal      Float
  promoId       String?
  // Selected modifier options snapshot:
  // [{ groupId, groupName, optionId, optionName, priceAdjustment }]
  modifiers     Json?
  notes         String? // Kitchen notes per item ("no onion", "extra spicy")
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([productId])
  @@index([createdAt])
  @@index([transactionId, createdAt])
  @@index([productId, createdAt])
  @@map("transaction_items")
}

// ──────────────────────────────────────────────────────────────
// Modifier System (F&B variants & add-ons)
// e.g. "Level Pedas" group → "Tidak Pedas / Sedang / Pedas / Extra"
//      "Topping" group → "Cheese +5K / Mozzarella +8K / Telur +3K"
// ──────────────────────────────────────────────────────────────
model ModifierGroup {
  id        String                 @id @default(uuid())
  companyId String
  company   Company                @relation(fields: [companyId], references: [id])
  name      String // Display label
  required  Boolean                @default(false)
  minSelect Int                    @default(0)
  maxSelect Int                    @default(1)
  sortOrder Int                    @default(0)
  isActive  Boolean                @default(true)
  options   ModifierOption[]
  products  ProductModifierGroup[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([companyId])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String        @id @default(uuid())
  groupId         String
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Float         @default(0)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([groupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  id              String        @id @default(uuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0)

  @@unique([productId, modifierGroupId])
  @@index([productId])
  @@index([modifierGroupId])
  @@map("product_modifier_groups")
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Float
  reference     String?
  createdAt     DateTime      @default(now())

  @@index([transactionId])
  @@map("payments")
}

model Refund {
  id            String        @id @default(uuid())
  transactionId String        @unique
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  reason        String
  refundAmount  Float
  refundMethod  PaymentMethod @default(CASH)
  refundedBy    String?
  isPartial     Boolean       @default(false)
  itemsReturned String? // JSON of returned items
  createdAt     DateTime      @default(now())

  @@index([transactionId])
  @@map("refunds")
}

// ===========================
// STOCK
// ===========================

model StockMovement {
  id           String            @id @default(uuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  companyId    String?
  type         StockMovementType
  // Magnitude positif. Direction encoded di `direction` agar query running
  // balance bisa pakai aritmatika langsung tanpa CASE WHEN type IN (...).
  quantity     Int
  direction    String?           // "IN" | "OUT" — null untuk row legacy
  // Running balance branch_stock setelah movement ini (per branch+product).
  // Null untuk row legacy sebelum ledger refactor — UI kartu stok fallback
  // ke recompute kalau null.
  balanceAfter Int?
  // Costing — diisi oleh service saat dipakai (Opsi B). Boleh null.
  unitCost     Decimal?          @db.Decimal(14, 2)
  totalCost    Decimal?          @db.Decimal(14, 2)
  // Referensi polymorphic ke dokumen sumber. refType: "purchase_order",
  // "transaction", "stock_transfer", "stock_opname", "return_exchange",
  // "manual_adjustment", dll.
  refType      String?
  refId        String?
  // Human-readable nomor dokumen (PO-001, INV-202506-001) — duplikasi dari
  // `reference` untuk row baru, dipertahankan utk display.
  refNumber    String?
  note         String?
  reference    String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  @@index([productId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@index([reference])
  @@index([branchId, createdAt])
  @@index([productId, createdAt])
  @@index([branchId, productId, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

model StockOpname {
  id           String            @id @default(uuid())
  opnameNumber String            @unique
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  companyId    String?
  status       StockOpnameStatus @default(DRAFT)
  notes        String?
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        StockOpnameItem[]

  @@index([status])
  @@index([branchId])
  @@map("stock_opnames")
}

model StockOpnameItem {
  id            String      @id @default(uuid())
  stockOpnameId String
  stockOpname   StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  systemStock   Int
  actualStock   Int
  difference    Int
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([stockOpnameId])
  @@index([productId])
  @@map("stock_opname_items")
}

model StockTransfer {
  id             String              @id @default(uuid())
  transferNumber String              @unique
  fromBranchId   String
  fromBranch     Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  companyId      String?
  status         StockTransferStatus @default(PENDING)
  notes          String?
  requestedBy    String?
  approvedBy     String?
  requestedAt    DateTime            @default(now())
  approvedAt     DateTime?
  receivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          StockTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
