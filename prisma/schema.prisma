generator client {
  provider      = "prisma-client-js"
  // native = builder OS (debian); linux-musl = runtime alpine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================
// ENUMS
// ===========================

// Role enum kept for type reference / seed - actual field uses String
enum Role {
  PLATFORM_OWNER
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
}

model AppRole {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "SUPER_ADMIN", "CUSTOM_SALES"
  name        String // Display name
  description String?
  color       String? // Tailwind color class
  isSystem    Boolean  @default(false) // System roles can't be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("app_roles")
}

enum StockMovementType {
  // Legacy (data lama sebelum ledger refactor)
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  OPNAME
  // Granular — service ledger pakai ini sejak refactor
  PURCHASE_RECEIVE
  SALE
  RETURN_IN
  RETURN_OUT
  TRANSFER_OUT
  TRANSFER_IN
  OPNAME_ADJUSTMENT
  WASTE
  RECIPE_DEDUCT
  MANUAL_IN
  MANUAL_OUT
  RTV
}

enum TransactionStatus {
  DRAFT
  COMPLETED
  PENDING
  HELD
  VOIDED
  REFUNDED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  EWALLET
  DEBIT
  CREDIT_CARD
  TERMIN
  // Bukan metode konkret — penanda bahwa transaksi pakai Split Bill (banyak
  // pembayar). Detail per orang ada di tabel Payment (lewat personLabel).
  // Backend auto-set value ini saat ada payment row dengan personLabel.
  SPLIT_BILL
}

enum MemberLevel {
  REGULAR
  SILVER
  GOLD
  PLATINUM
}

enum PromoType {
  DISCOUNT_PERCENT
  DISCOUNT_AMOUNT
  BUY_X_GET_Y
  VOUCHER
  BUNDLE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CLOSED
  CANCELLED
}

enum StockOpnameStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
  REJECTED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

// ===========================
// CORE
// ===========================

model Company {
  id                   String                     @id @default(uuid())
  name                 String
  slug                 String                     @unique // URL-friendly identifier
  address              String?
  phone                String?
  email                String?
  logo                 String?
  plan                 String                     @default("FREE") // FREE, PRO, ENTERPRISE
  // Jenis usaha — drive ketersediaan menu di sidebar.
  // RETAIL, BENGKEL, RESTAURANT, CAFE.
  businessUnit         String                     @default("RETAIL")
  planExpiresAt        DateTime?
  isActive             Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  users                User[]
  branches             Branch[]
  categories           Category[]
  brands               Brand[]
  products             Product[]
  suppliers            Supplier[]
  customers            Customer[]
  promotions           Promotion[]
  accountCategories    AccountCategory[]
  subscriptionPayments SubscriptionPayment[]
  recurringTemplates   RecurringJournalTemplate[]
  bankReconciliations  BankReconciliation[]
  modifierGroups       ModifierGroup[]
  whatsappSession      WhatsappSession?
  whatsappBotConfig    WhatsappBotConfig?
  shopeeAccounts       ShopeeAccount[]
  grabAccounts         GrabAccount[]
  racks                Rack[]

  @@index([slug])
  @@map("companies")
}

model User {
  id                      String                     @id @default(uuid())
  name                    String
  email                   String                     @unique
  phone                   String?
  password                String
  // Password otorisasi untuk aksi sensitif (void/refund/hapus transaksi, dll).
  // Berbeda dari `password` (login). Nullable untuk backward-compat — user lama
  // bisa set lewat profile. Hashed sama seperti password login (bcrypt).
  authorizationPassword   String?
  role                    String                     @default("CASHIER")
  // Bengkel: User dengan flag ini bisa di-assign sebagai mekanik di
  // ServiceOrder & ServiceOrderItem (untuk komisi/payroll).
  isMechanic              Boolean                    @default(false)
  companyId               String?
  company                 Company?                   @relation(fields: [companyId], references: [id])
  branchId                String?
  branch                  Branch?                    @relation(fields: [branchId], references: [id])
  // Multi-branch — user bisa di-assign ke beberapa cabang sekaligus. `branchId`
  // tetap dipakai sebagai primary/default branch (utk POS context default).
  // `branches` (M2M) untuk authorization "user X boleh akses cabang Y?".
  branches                UserBranch[]
  isActive                Boolean                    @default(true)
  emailVerified           Boolean                    @default(false)
  phoneVerified           Boolean                    @default(false)
  deletedAt               DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  transactions            Transaction[]
  auditLogs               AuditLog[]
  activityLogs            ActivityLog[]
  cashierShifts           CashierShift[]
  debtsCreated            Debt[]
  debtPayments            DebtPayment[]
  returnsProcessed        ReturnExchange[]           @relation("ReturnProcessedBy")
  giftCardsCreated        GiftCard[]                 @relation("GiftCardCreatedBy")
  salesTargets            SalesTarget[]
  badges                  CashierBadge[]
  schedules               EmployeeSchedule[]
  favorites               CashierFavorite[]
  journalsCreated         JournalEntry[]             @relation("JournalCreatedBy")
  journalsApproved        JournalEntry[]             @relation("JournalApprovedBy")
  journalChangeLogs       JournalChangeLog[]
  recurringTemplates      RecurringJournalTemplate[]
  tableOrdersApproved     TableOrder[]
  serviceOrdersAsMechanic ServiceOrder[]             @relation("ServiceOrderMechanic")
  serviceOrderItems       ServiceOrderItem[]         @relation("ServiceOrderItemMechanic")
  bookingsAsMechanic      Booking[]                  @relation("BookingMechanic")
  bookingsCreated         Booking[]                  @relation("BookingCreatedBy")
  rackMovements           RackStockMovement[]
  discrepanciesReported   RackDiscrepancy[]          @relation("DiscrepancyReporter")
  discrepanciesResolved   RackDiscrepancy[]          @relation("DiscrepancyResolver")

  @@index([email])
  @@index([role])
  @@index([companyId])
  @@index([branchId])
  @@index([isMechanic])
  @@map("users")
}

model AppMenu {
  id            String               @id @default(uuid())
  key           String               @unique
  name          String
  path          String               @unique
  group         String
  // Sub-grouping di dalam `group` untuk visual hierarchy di sidebar
  // (mis. Inventori → Purchase → [Purchase Order, Receiving]). Null = item
  // langsung di-render di bawah header group tanpa sub-heading.
  subgroup      String?
  sortOrder     Int                  @default(0)
  isActive      Boolean              @default(true)
  // Daftar business unit yang bisa lihat menu ini (mis. ["BENGKEL"] berarti
  // hanya company businessUnit=BENGKEL). NULL atau empty = available untuk
  // semua. Default null supaya semua menu existing tetap visible.
  businessUnits Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  actions       MenuAction[]
  roleMenus     RoleMenuPermission[]

  @@index([group])
  @@index([sortOrder])
  @@index([isActive])
  @@map("app_menus")
}

model MenuAction {
  id          String                 @id @default(uuid())
  menuId      String
  menu        AppMenu                @relation(fields: [menuId], references: [id], onDelete: Cascade)
  key         String
  name        String
  sortOrder   Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  roleActions RoleActionPermission[]

  @@unique([menuId, key])
  @@index([menuId])
  @@index([sortOrder])
  @@index([isActive])
  @@map("menu_actions")
}

model RoleMenuPermission {
  id        String   @id @default(uuid())
  role      String
  menuId    String
  menu      AppMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, menuId])
  @@index([role])
  @@index([menuId])
  @@map("role_menu_permissions")
}

model RoleActionPermission {
  id           String     @id @default(uuid())
  role         String
  menuActionId String
  menuAction   MenuAction @relation(fields: [menuActionId], references: [id], onDelete: Cascade)
  allowed      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([role, menuActionId])
  @@index([role])
  @@index([menuActionId])
  @@map("role_action_permissions")
}

/// Junction table User ↔ Branch — implementasi multi-branch assignment.
/// User.branchId masih dipakai sebagai "primary" branch (default context POS).
/// UserBranch dipakai untuk authorization & filter (cek apakah user X boleh
/// switch ke branch Y).
model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branches")
}

model Branch {
  id                 String                     @id @default(uuid())
  name               String
  code               String?
  address            String?
  phone              String?
  latitude           Float?
  longitude          Float?
  companyId          String
  company            Company                    @relation(fields: [companyId], references: [id])
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  users              User[]
  userBranches       UserBranch[]
  stockTransfersFrom StockTransfer[]            @relation("TransferFrom")
  stockTransfersTo   StockTransfer[]            @relation("TransferTo")
  stockOpnames       StockOpname[]
  stockUsages        StockUsage[]
  productPrices      BranchProductPrice[]
  branchStocks       BranchStock[]
  stockMovements     StockMovement[]
  transactions       Transaction[]
  purchaseOrders     PurchaseOrder[]
  cashierShifts      CashierShift[]
  expenses           Expense[]
  auditLogs          AuditLog[]
  settings           Setting[]
  debts              Debt[]
  returnExchanges    ReturnExchange[]
  giftCards          GiftCard[]
  salesTargets       SalesTarget[]
  employeeSchedules  EmployeeSchedule[]
  orderQueues        OrderQueue[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  restaurantTables   RestaurantTable[]
  productBundles     ProductBundle[]
  promotions         Promotion[]
  closingReports     ClosingReport[]
  goodsReceipts      GoodsReceipt[]
  recurringTemplates RecurringJournalTemplate[]
  tableSessions      TableSession[]
  tableOrders        TableOrder[]
  serviceOrders      ServiceOrder[]
  bookings           Booking[]
  productBranchSkus  ProductBranchSku[]
  grabAccounts       GrabAccount[]
  racks              Rack[]
  rackStocks         RackStock[]
  rackMovements      RackStockMovement[]
  rackDiscrepancies  RackDiscrepancy[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model BranchProductPrice {
  id            String   @id @default(uuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellingPrice  Float
  purchasePrice Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_product_prices")
}

model BranchStock {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  minStock  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_stocks")
}

// ===========================
// PRODUK
// ===========================

model Category {
  id          String          @id @default(uuid())
  name        String
  description String?
  parentId    String?
  parent      Category?       @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[]      @relation("SubCategories")
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  // PRODUCT (default, kategori produk) atau VEHICLE_MODEL (model kendaraan
  // bengkel — relate ke brand kendaraan).
  kind        String          @default("PRODUCT")
  // Untuk VEHICLE_MODEL: relasi ke Brand (mis. model "Vario 150" milik
  // brand "Honda"). Null untuk kategori produk biasa.
  brandId     String?
  brand       Brand?          @relation("CategoryBrand", fields: [brandId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  products    Product[]
  promotions  Promotion[]
  bundles     ProductBundle[]
  vehicles    Vehicle[]       @relation("VehicleModel")

  @@unique([companyId, name])
  @@index([parentId])
  @@index([companyId])
  @@index([kind])
  @@index([brandId])
  @@map("categories")
}

model Brand {
  id        String     @id @default(uuid())
  name      String
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  // PRODUCT (default) atau VEHICLE — Honda, Toyota, dll untuk bengkel.
  kind      String     @default("PRODUCT")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  models    Category[] @relation("CategoryBrand")
  vehicles  Vehicle[]  @relation("VehicleBrand")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([kind])
  @@map("brands")
}

model Product {
  id                  String                      @id @default(uuid())
  code                String
  name                String
  categoryId          String
  category            Category                    @relation(fields: [categoryId], references: [id])
  brandId             String?
  brand               Brand?                      @relation(fields: [brandId], references: [id])
  supplierId          String?
  supplier            Supplier?                   @relation(fields: [supplierId], references: [id])
  companyId           String
  company             Company                     @relation(fields: [companyId], references: [id])
  purchasePrice       Float
  sellingPrice        Float
  stock               Int                         @default(0)
  minStock            Int                         @default(5)
  barcode             String?
  unit                String                      @default("pcs")
  // PRODUCT = barang fisik dengan stock; SERVICE = jasa (no stock validation,
  // skip stock movement, dipakai bisnis bengkel/jasa). Default PRODUCT supaya
  // backward-compat.
  itemType            String                      @default("PRODUCT")
  isActive            Boolean                     @default(true)
  description         String?
  imageUrl            String?
  // ── Search-by-Image (phase58) ─────────────────────────────────────────
  // Vektor gambar pgvector. `Unsupported` → TIDAK bisa di-select/where lewat
  // Prisma Client; semua akses via $queryRaw (lihat ImageSearchService).
  // Nullable, jadi create/update Prisma biasa tetap jalan tanpa perubahan.
  // Dimensi 768 HARUS sama dengan VECTOR_DIMENSION + /health.dim ai-service.
  embedding           Unsupported("vector(768)")?
  embeddedAt          DateTime?
  embeddingModel      String?
  // imageUrl saat embedding dibuat. Beda dari imageUrl = embedding stale.
  embeddedImageUrl    String?

  expiryDate          DateTime?
  // Aktifkan pelacakan batch/lot + expired per-batch (FEFO + product recall).
  // Default false → produk lama tetap pakai stok agregat tanpa batch (helper
  // batch no-op). Lihat model ProductBatch.
  trackBatch          Boolean                     @default(false)
  deletedAt           DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  transactionItems    TransactionItem[]
  stockMovements      StockMovement[]
  promotions          Promotion[]
  promoTriggers       PromotionTriggerProduct[]   @relation("ProductPromoTriggers")
  promoRewards        PromotionGetProduct[]       @relation("ProductPromoRewards")
  purchaseOrderItems  PurchaseOrderItem[]
  stockOpnameItems    StockOpnameItem[]
  stockUsageItems     StockUsageItem[]
  branchPrices        BranchProductPrice[]
  branchStocks        BranchStock[]
  units               ProductUnit[]
  variants            ProductVariant[]
  branchSkus          ProductBranchSku[]
  tierPrices          ProductTierPrice[]
  returnItems         ReturnExchangeItem[]
  exchangeItems       ReturnExchangeItem[]        @relation("ExchangeProduct")
  cashierFavorites    CashierFavorite[]
  bundleItems         ProductBundleItem[]
  modifierGroups      ProductModifierGroup[]
  tableOrderItems     TableOrderItem[]
  recipe              Recipe?
  usedInRecipes       RecipeIngredient[]          @relation("RecipeIngredient")
  marketplaceMappings ProductMarketplaceMapping[]
  shopeeItems         ShopeeItem[]
  defaultRackId       String?
  defaultRack         Rack?                       @relation("ProductDefaultRack", fields: [defaultRackId], references: [id])
  rackStocks          RackStock[]
  rackMovements       RackStockMovement[]
  rackDiscrepancies   RackDiscrepancy[]

  @@unique([companyId, code])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([barcode])
  @@index([name])
  @@index([isActive, stock])
  @@index([defaultRackId])
  @@map("products")
}

model ProductUnit {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // e.g. "Box", "Bungkus", "Batang"
  conversionQty Int // how many base units in 1 of this unit (Batang=1, Bungkus=16, Box=192)
  sellingPrice  Float // selling price for this unit
  purchasePrice Float? // purchase price for this unit (optional)
  barcode       String? // optional barcode for this unit
  isDefault     Boolean  @default(false) // is this the default selling unit?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branchSkus    ProductBranchSku[]
  purchaseItems PurchaseOrderItem[]
  stockMovements StockMovement[]
  promotions    Promotion[]

  @@unique([productId, name])
  @@index([productId])
  @@index([barcode])
  @@map("product_units")
}

// ProductVariant — kombinasi modifier options dengan harga & stok sendiri.
// Use case: baju Hitam-XL stok 3 harga 80rb, Putih-M stok 5 harga 75rb.
// Lookup: cari variant dimana set ProductVariantOption.optionId sama persis
// dengan kombinasi modifier yang dipilih customer di POS.
// Kalau no variant match → fallback ke product.sellingPrice + product.stock.
model ProductVariant {
  id                    String                 @id @default(uuid())
  productId             String
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Override harga jual. Null = pakai product.sellingPrice.
  priceOverride         Float?
  // Override harga beli (untuk HPP/COGS akurat per variant). Null = product.purchasePrice.
  purchasePriceOverride Float?
  stock                 Int                    @default(0)
  barcode               String?                @unique
  isActive              Boolean                @default(true)
  options               ProductVariantOption[]
  branchSkus            ProductBranchSku[]
  stockMovements        StockMovement[]
  purchaseItems         PurchaseOrderItem[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([productId])
  @@map("product_variants")
}

// Single source of truth untuk inventory & harga di level "leaf cell":
// (Cabang × Satuan × Varian). Tiap row = 1 SKU dengan harga + stok sendiri.
// Kombinasi:
//   - Produk simple: 1 row per cabang (unitId=null, variantId=null)
//   - Produk multi-unit (rokok): N row per cabang × satuan (variantId=null)
//   - Produk dengan varian (baju): N row per cabang × varian (unitId=null)
//   - Full matrix (baju multi-pack): per cabang × satuan × varian
// App-level enforce uniqueness (productId, branchId, unitId-or-null, variantId-or-null).
model ProductBranchSku {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // null = pakai satuan dasar (product.unit). Set kalau produk multi-unit.
  unitId        String?
  unit          ProductUnit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // null = produk tanpa varian. Set kalau produk pakai modifier dependency.
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sellingPrice  Float
  purchasePrice Float
  stock         Int             @default(0)
  minStock      Int             @default(5)
  barcode       String?         @unique
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([productId])
  @@index([branchId])
  @@index([productId, branchId])
  @@index([barcode])
  @@map("product_branch_skus")
}

// Junction: variant terdiri dari N modifier options. Kombinasi lengkap
// = set optionIds yang membentuk SKU unik. Tidak bisa duplicate option per
// variant (1 variant = 1 option per group).
model ProductVariantOption {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String
  option    ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([optionId])
  @@map("product_variant_options")
}

model ProductTierPrice {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, minQty])
  @@index([productId])
  @@index([minQty])
  @@map("product_tier_prices")
}

// ===========================
// SUPPLIER
// ===========================

model Supplier {
  id               String            @id @default(uuid())
  name             String
  contact          String?
  address          String?
  email            String?
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]

  @@index([companyId])
  @@map("suppliers")
}

model SupplierPayment {
  id         String        @id @default(uuid())
  supplierId String
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  poId       String?
  amount     Float
  method     PaymentMethod @default(TRANSFER)
  reference  String?
  notes      String?
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([supplierId])
  @@index([paidAt])
  @@map("supplier_payments")
}

// ===========================
// CUSTOMER
// ===========================

model Customer {
  id             String                 @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  memberLevel    MemberLevel            @default(REGULAR)
  totalSpending  Float                  @default(0)
  points         Int                    @default(0)
  memberCardCode String?
  dateOfBirth    DateTime?
  // Batas kredit untuk pembelian TERMIN (piutang). 0 = tanpa batas (default
  // aman supaya customer lama tidak terhalang). Saat checkout TERMIN, backend
  // tolak jika outstanding piutang + nominal termin baru > creditLimit, kecuali
  // ada override otorisasi supervisor.
  creditLimit    Float                  @default(0)
  // Tempo default (hari) untuk piutang customer ini. Dipakai sebagai dueDate
  // saat termin tanpa konfigurasi cicilan eksplisit.
  creditTermDays Int                    @default(30)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   Transaction[]
  pointHistories CustomerPointHistory[]
  returns        ReturnExchange[]
  giftCards      GiftCard[]
  vehicles       Vehicle[]
  serviceOrders  ServiceOrder[]
  bookings       Booking[]

  @@unique([companyId, phone])
  @@unique([companyId, memberCardCode])
  @@index([companyId])
  @@index([phone])
  @@index([memberCardCode])
  @@index([memberLevel])
  @@map("customers")
}

model CustomerPointHistory {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points      Int
  type        String // EARN, REDEEM, EXPIRED, ADJUST
  reference   String? // invoice number or reason
  description String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_point_histories")
}

// ===========================
// TRANSAKSI
// ===========================

model Transaction {
  id                   String            @id @default(uuid())
  // Global-unique invoice — composite "{COMPANY_SLUG}-{BRANCH_CODE}-{RAND}".
  // Tetap dipakai sebagai authoritative ID lintas system (export, audit log).
  invoiceNumber        String            @unique
  // Display invoice — readable per company per hari, format
  // "INV-DDMMYYYY-NNNNN" (NNNNN sequential per companyId per date).
  // Nullable utk row legacy sebelum kolom ini dibuat.
  invoiceDisplayNumber String?
  // Denormalized companyId (sumber: user.companyId) supaya unique constraint
  // (companyId, invoiceDisplayNumber) bisa dipasang langsung.
  companyId            String?
  userId               String
  user                 User              @relation(fields: [userId], references: [id])
  branchId             String?
  branch               Branch?           @relation(fields: [branchId], references: [id])
  customerId           String?
  customer             Customer?         @relation(fields: [customerId], references: [id])
  subtotal             Float
  discountAmount       Float             @default(0)
  taxAmount            Float             @default(0)
  grandTotal           Float
  paymentMethod        PaymentMethod     @default(CASH)
  paymentAmount        Float
  changeAmount         Float             @default(0)
  status               TransactionStatus @default(COMPLETED)
  voidReason           String?
  promoApplied         String?
  notes                String?
  // Kunci idempoten dari client (= id antrian offline). Dipakai supaya retry
  // sinkronisasi transaksi offline tidak membuat duplikat: kalau key sudah
  // ada untuk company ini, checkout mengembalikan transaksi yang sudah ada.
  // NULL untuk transaksi online biasa (banyak NULL diizinkan di composite unique).
  idempotencyKey       String?
  // True kalau transaksi ini dibuat saat offline lalu disinkronkan. Dipakai
  // untuk menandai di riwayat agar staf bisa memverifikasi promo/poin/customer
  // yang mungkin tidak terhitung saat offline.
  syncedFromOffline    Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  items                TransactionItem[]
  payments             Payment[]
  refund               Refund?
  returns              ReturnExchange[]
  orderQueues          OrderQueue[]
  paymentOrders        PaymentOrder[]
  tableId              String?
  table                RestaurantTable?  @relation(fields: [tableId], references: [id])
  tableSession         TableSession?
  // Bengkel: Transaction yang berasal dari finalize ServiceOrder.
  serviceOrder         ServiceOrder?     @relation("ServiceOrderTransaction")

  @@unique([companyId, invoiceDisplayNumber])
  @@unique([companyId, idempotencyKey])
  @@index([invoiceNumber])
  @@index([userId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
  @@index([branchId, status, createdAt])
  @@index([companyId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  productName   String
  productCode   String
  quantity      Int
  unitName      String      @default("PCS")
  conversionQty Int         @default(1)
  baseQty       Int?
  unitPrice     Float
  discount      Float       @default(0)
  subtotal      Float
  promoId       String?
  // Tag asal promo per item — disetel saat checkout supaya detail riwayat
  // bisa render badge:
  //   "GIFT"             — hadiah otomatis dari BUY_X_GET_Y
  //   "TEBUS"            — produk tebus murah (BUNDLE)
  //   "DISCOUNT_PERCENT" — kena diskon persen (manual atau promo)
  //   "DISCOUNT_AMOUNT"  — kena diskon nominal Rp (manual atau promo)
  //   "VOUCHER"          — kena potongan voucher
  // NULL = tidak ada promo. Optional & murni untuk tampilan.
  promoType     String?
  promoName     String?
  // Selected modifier options snapshot:
  // [{ groupId, groupName, optionId, optionName, priceAdjustment }]
  modifiers     Json?
  notes         String? // Kitchen notes per item ("no onion", "extra spicy")
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([productId])
  @@index([createdAt])
  @@index([transactionId, createdAt])
  @@index([productId, createdAt])
  @@map("transaction_items")
}

// ──────────────────────────────────────────────────────────────
// Modifier System (F&B variants & add-ons)
// e.g. "Level Pedas" group → "Tidak Pedas / Sedang / Pedas / Extra"
//      "Topping" group → "Cheese +5K / Mozzarella +8K / Telur +3K"
// ──────────────────────────────────────────────────────────────
model ModifierGroup {
  id        String                 @id @default(uuid())
  companyId String
  company   Company                @relation(fields: [companyId], references: [id])
  name      String // Display label
  required  Boolean                @default(false)
  minSelect Int                    @default(0)
  maxSelect Int                    @default(1)
  sortOrder Int                    @default(0)
  isActive  Boolean                @default(true)
  options   ModifierOption[]
  products  ProductModifierGroup[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([companyId])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String                     @id @default(uuid())
  groupId         String
  group           ModifierGroup              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Float                      @default(0)
  isActive        Boolean                    @default(true)
  sortOrder       Int                        @default(0)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  // Dependency m2m self-reference. Sebuah option bisa "diaktifkan" oleh
  // satu/banyak parent option dari group LAIN. Contoh: option "XL" di group
  // "Ukuran" di-enable oleh ["Hitam"] di group "Warna" — saat user pick
  // Hitam, opsi XL muncul; saat pilih Putih, XL ke-hide.
  // - `enables`: edges di mana option ini = parent (membuat option lain visible)
  // - `enabledBy`: edges di mana option ini = dependent (visible kalau parent dipilih)
  enables         ModifierOptionDependency[] @relation("EnablesOption")
  enabledBy       ModifierOptionDependency[] @relation("EnabledByOption")
  variants        ProductVariantOption[]

  @@index([groupId])
  @@map("modifier_options")
}

// Conditional modifier: parent option selection mem-filter dependent options.
// Tanpa entry → option tidak punya constraint (selalu visible).
// Dengan entry → option visible HANYA kalau salah satu parentnya ke-pilih.
model ModifierOptionDependency {
  parentOptionId    String
  parentOption      ModifierOption @relation("EnablesOption", fields: [parentOptionId], references: [id], onDelete: Cascade)
  dependentOptionId String
  dependentOption   ModifierOption @relation("EnabledByOption", fields: [dependentOptionId], references: [id], onDelete: Cascade)

  @@id([parentOptionId, dependentOptionId])
  @@index([parentOptionId])
  @@index([dependentOptionId])
  @@map("modifier_option_dependencies")
}

model ProductModifierGroup {
  id              String        @id @default(uuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0)

  @@unique([productId, modifierGroupId])
  @@index([productId])
  @@index([modifierGroupId])
  @@map("product_modifier_groups")
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Float
  // Detail referensi (bank name, no rekening, ref code, dll) untuk metode
  // non-tunai. Free-form karena formatnya beragam.
  reference     String?
  // Identitas pembayar untuk Split Bill ("Orang 1", "Andi", dll). NULL untuk
  // pembayaran multi-method oleh 1 orang. Detail modal pakai field ini untuk
  // menampilkan header "Split Bill - N orang" dan group by person.
  personLabel   String?
  createdAt     DateTime      @default(now())

  @@index([transactionId])
  @@map("payments")
}

model Refund {
  id            String        @id @default(uuid())
  transactionId String        @unique
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  reason        String
  refundAmount  Float
  refundMethod  PaymentMethod @default(CASH)
  refundedBy    String?
  isPartial     Boolean       @default(false)
  itemsReturned String? // JSON of returned items
  createdAt     DateTime      @default(now())

  @@index([transactionId])
  @@map("refunds")
}

// ===========================
// STOCK
// ===========================

model StockMovement {
  id           String            @id @default(uuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  // Variant terkait pergerakan stok ini. Null = produk tanpa variant atau
  // movement non-sale (PO, opname, transfer di level produk). Di-set di
  // SALE / RECIPE_DEDUCT bila item POS punya pilihan modifier yang resolve
  // ke ProductVariant.
  variantId    String?
  variant      ProductVariant?   @relation(fields: [variantId], references: [id])
  // Denormalized label varian untuk display ("Putih · S"). Disimpan supaya
  // kartu stok bisa render tanpa join ke modifier_options tiap row.
  variantLabel String?
  unitId       String?
  unit         ProductUnit?      @relation(fields: [unitId], references: [id])
  unitQuantity Int?
  companyId    String?
  type         StockMovementType
  // Magnitude positif. Direction encoded di `direction` agar query running
  // balance bisa pakai aritmatika langsung tanpa CASE WHEN type IN (...).
  quantity     Int
  direction    String? // "IN" | "OUT" — null untuk row legacy
  // Running balance branch_stock setelah movement ini (per branch+product).
  // Null untuk row legacy sebelum ledger refactor — UI kartu stok fallback
  // ke recompute kalau null.
  balanceAfter Int?
  // Costing — diisi oleh service saat dipakai (Opsi B). Boleh null.
  unitCost     Decimal?          @db.Decimal(14, 2)
  totalCost    Decimal?          @db.Decimal(14, 2)
  // Referensi polymorphic ke dokumen sumber. refType: "purchase_order",
  // "transaction", "stock_transfer", "stock_opname", "return_exchange",
  // "manual_adjustment", dll.
  refType      String?
  refId        String?
  // Human-readable nomor dokumen (PO-001, INV-202506-001) — duplikasi dari
  // `reference` untuk row baru, dipertahankan utk display.
  refNumber    String?
  note         String?
  reference    String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  @@index([productId])
  @@index([branchId])
  @@index([variantId])
  @@index([unitId])
  @@index([type])
  @@index([createdAt])
  @@index([reference])
  @@index([branchId, createdAt])
  @@index([productId, createdAt])
  @@index([branchId, productId, createdAt])
  @@index([productId, variantId, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

model StockOpname {
  id           String            @id @default(uuid())
  // Unique scoped per company — sequence reset per company per hari.
  opnameNumber String
  branchId     String?
  branch       Branch?           @relation(fields: [branchId], references: [id])
  companyId    String?
  status       StockOpnameStatus @default(DRAFT)
  notes        String?
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        StockOpnameItem[]

  @@unique([companyId, opnameNumber])
  @@index([status])
  @@index([branchId])
  @@map("stock_opnames")
}

model StockOpnameItem {
  id            String      @id @default(uuid())
  stockOpnameId String
  stockOpname   StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  systemStock   Int
  actualStock   Int
  difference    Int
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([stockOpnameId])
  @@index([productId])
  @@map("stock_opname_items")
}

// Pemakaian Barang (Goods Issue) — pengeluaran stok karena DIPAKAI/dikonsumsi
// internal (mis. sparepart untuk perbaikan mesin), bukan dijual. Tidak ada
// harga/customer/pembayaran. Stok berkurang via StockMovement MANUAL_OUT.
model StockUsage {
  id          String           @id @default(uuid())
  // Unique per company — nomor dokumen pemakaian (mis. PMK-20260605-0001).
  usageNumber String
  branchId    String?
  branch      Branch?          @relation(fields: [branchId], references: [id])
  companyId   String?
  // Nama peminta (mekanik/operator) — free text supaya tidak wajib master.
  requestedBy String?
  // Tujuan/keperluan: mesin / line produksi (untuk laporan konsumsi per mesin).
  purpose     String?
  // Nomor work order / perintah kerja (opsional).
  woNumber    String?
  notes       String?
  // COMPLETED saat dibuat (langsung potong stok). DRAFT/CANCELLED utk masa depan.
  status      String           @default("COMPLETED")
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       StockUsageItem[]

  @@unique([companyId, usageNumber])
  @@index([branchId])
  @@index([companyId, createdAt])
  @@map("stock_usages")
}

model StockUsageItem {
  id           String     @id @default(uuid())
  stockUsageId String
  stockUsage   StockUsage @relation(fields: [stockUsageId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  variantId    String?
  unitId       String?
  rackId       String?
  // Qty dalam satuan yang dipilih user.
  quantity     Int
  // Qty dalam satuan DASAR (untuk konsistensi ledger & laporan).
  baseQuantity Int
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([stockUsageId])
  @@index([productId])
  @@map("stock_usage_items")
}

model StockTransfer {
  id             String              @id @default(uuid())
  // Unique scoped per company — sequence reset per company per hari.
  transferNumber String
  fromBranchId   String
  fromBranch     Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  companyId      String?
  status         StockTransferStatus @default(PENDING)
  notes          String?
  requestedBy    String?
  approvedBy     String?
  requestedAt    DateTime            @default(now())
  approvedAt     DateTime?
  receivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          StockTransferItem[]

  @@unique([companyId, transferNumber])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(uuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  quantity        Int
  receivedQty     Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([stockTransferId])
  @@map("stock_transfer_items")
}

// ===========================
// PURCHASE
// ===========================

model PurchaseOrder {
  id                        String                   @id @default(uuid())
  // Unique scoped per company — sequence reset per company per hari.
  orderNumber               String
  // No transaksi pembelian (BL-YYYYMMDD-NNNN) — generated saat PO dibuat,
  // sequence per hari per company. Format: BL-20260509-0001.
  // Dipakai sebagai identifier utama di Laporan Pembelian.
  // Unique scoped per company (multi-tenant), bukan global — karena
  // sequence reset per company per hari.
  purchaseTransactionNumber String
  supplierId                String
  supplier                  Supplier                 @relation(fields: [supplierId], references: [id])
  branchId                  String?
  branch                    Branch?                  @relation(fields: [branchId], references: [id])
  companyId                 String?
  status                    PurchaseOrderStatus      @default(DRAFT)
  totalAmount               Float                    @default(0)
  receivedAmount            Float                    @default(0)
  paidAmount                Float                    @default(0)
  notes                     String?
  closingNotes              String?
  orderDate                 DateTime                 @default(now())
  expectedDate              DateTime?
  receivedDate              DateTime?
  closedDate                DateTime?
  createdBy                 String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  items                     PurchaseOrderItem[]
  goodsReceipts             GoodsReceipt[]
  transactionLogs           PurchaseTransactionLog[]

  @@unique([companyId, purchaseTransactionNumber])
  @@unique([companyId, orderNumber])
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

// Laporan Pembelian — catat tiap perubahan status PO sebagai 1 row.
// `documentNumber` adaptif: PO number untuk stage PO, GR number untuk
// stage receiving, PT number untuk completion.
model PurchaseTransactionLog {
  id              String        @id @default(uuid())
  companyId       String
  branchId        String?
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // No. transaksi yang berlaku saat row ini dibuat. PO number, goods
  // receipt number, atau purchase transaction number.
  documentNumber  String
  // "PO" | "GR" | "PT" — supaya UI bisa render badge tipe dokumen.
  documentType    String
  // Status PO setelah event: DRAFT | ORDERED | PARTIAL | RECEIVED |
  // CLOSED | CANCELLED | COMPLETED.
  status          String
  // Total nilai relevan di event ini (PO total, receipt value, dst).
  amount          Float?
  note            String?
  createdBy       String?
  createdAt       DateTime      @default(now())

  @@index([companyId, createdAt])
  @@index([purchaseOrderId, createdAt])
  @@index([status])
  @@index([documentType])
  @@map("purchase_transaction_logs")
}

model PurchaseOrderItem {
  id                    String          @id @default(uuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId             String
  product               Product         @relation(fields: [productId], references: [id])
  // Satuan + varian SKU yang di-PO (untuk produk multi-unit / multi-variant).
  // Null untuk produk simple. Goods receipt nanti decrement stok di SKU ini.
  unitId                String?
  unit                  ProductUnit?    @relation(fields: [unitId], references: [id])
  variantId             String?
  variant               ProductVariant? @relation(fields: [variantId], references: [id])
  quantity              Int
  receivedQty           Int             @default(0)
  unitPrice             Float
  // Snapshot harga master sebelum receive pertama. Capture sekali saat receive
  // pertama dipanggil utk item ini. Dipakai di laporan pembelian utk
  // tampilkan perubahan harga beli tanpa JOIN ke goods receipts.
  previousPurchasePrice Float?
  subtotal              Float
  discrepancyQty        Int             @default(0)
  discrepancyReason     String?
  discrepancyNote       String?
  createdAt             DateTime        @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([unitId])
  @@index([variantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  // Unique scoped per company — sequence reset per company per hari.
  receiptNumber   String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  companyId       String?
  branchId        String?
  branch          Branch?            @relation(fields: [branchId], references: [id])
  receivedBy      String?
  receivedByName  String?
  notes           String?
  receivedAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  items           GoodsReceiptItem[]

  @@unique([companyId, receiptNumber])
  @@index([purchaseOrderId])
  @@index([companyId])
  @@index([branchId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                    String       @id @default(uuid())
  goodsReceiptId        String
  goodsReceipt          GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId             String
  productName           String
  quantityOrdered       Int
  quantityReceived      Int
  // Snapshot harga di PO saat diterima (harga "baru" yang akan jadi master).
  unitPrice             Float?
  // Snapshot harga master sebelum sync (harga "lama"). Null = tidak diketahui
  // / receipt lama sebelum fitur diaktifkan.
  previousPurchasePrice Float?
  notes                 String?
  createdAt             DateTime     @default(now())

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

// ===========================
// TRACEABILITY — BATCH & EXPIRED (FEFO)
// ===========================

// Batch/lot stok per produk per cabang. Lapisan ADITIF di atas BranchStock:
// BranchStock tetap source of truth untuk TOTAL qty; ProductBatch mencatat
// DARI batch mana qty itu berasal — untuk FEFO consume + product recall.
// Hanya dipakai untuk produk dgn Product.trackBatch = true; produk lain tidak
// membuat row di sini (helper no-op) → backward compatible. Relasi ke
// product/branch/supplier sengaja SCALAR-ONLY (+ nama denormalized) supaya
// tidak menambah back-ref di model existing — pola yang sama dipakai
// StockMovement/Debt di schema ini.
model ProductBatch {
  id             String                 @id @default(uuid())
  companyId      String
  productId      String
  productName    String
  branchId       String?
  variantId      String?
  variantLabel   String?
  // Nomor batch/lot dari supplier (atau auto-generate kalau kosong).
  batchNumber    String
  // Kunci FEFO (First Expired First Out). Null = tanpa expiry → di-consume
  // paling akhir.
  expiryDate     DateTime?
  supplierId     String?
  supplierName   String?
  goodsReceiptId String?
  // Qty awal masuk (satuan stok yang sama dgn BranchStock.quantity).
  receivedQty    Int
  // Sisa qty batch ini saat ini. FEFO consume mengurangi nilai ini.
  remainingQty   Int
  unitCost       Decimal?               @db.Decimal(14, 2)
  // ACTIVE | DEPLETED | EXPIRED | RECALLED
  status         String                 @default("ACTIVE")
  receivedAt     DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  movements      ProductBatchMovement[]

  @@index([companyId])
  @@index([productId, branchId])
  @@index([productId, branchId, status])
  @@index([expiryDate])
  @@index([batchNumber])
  @@index([status])
  @@map("product_batches")
}

// Ledger pergerakan batch (audit + recall trace). OUT row dgn refType =
// "transaction" + refId = transactionId → jejak "batch X terjual di transaksi
// mana / ke pelanggan siapa".
model ProductBatchMovement {
  id             String       @id @default(uuid())
  batchId        String
  batch          ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  companyId      String?
  productId      String
  branchId       String?
  // IN | OUT | ADJUST | RECALL | EXPIRE
  type           String
  // IN | OUT
  direction      String
  quantity       Int
  remainingAfter Int
  // Referensi dokumen sumber: goods_receipt | transaction | stock_opname |
  // recall | manual.
  refType        String?
  refId          String?
  refNumber      String?
  note           String?
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([batchId])
  @@index([productId, branchId])
  @@index([refType, refId])
  @@index([createdAt])
  @@map("product_batch_movements")
}

// ===========================
// KASIR
// ===========================

model CashierShift {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  branchId          String?
  branch            Branch?        @relation(fields: [branchId], references: [id])
  openedAt          DateTime       @default(now())
  closedAt          DateTime?
  openingCash       Float
  closingCash       Float?
  expectedCash      Float?
  cashDifference    Float?
  totalSales        Float?
  totalTransactions Int?
  notes             String?
  isOpen            Boolean        @default(true)
  cashMovements     CashMovement[]
  closingReport     ClosingReport?

  @@index([userId])
  @@index([branchId])
  @@index([isOpen])
  @@index([openedAt])
  @@map("cashier_shifts")
}

model ClosingReport {
  id                String       @id @default(uuid())
  shiftId           String       @unique
  shift             CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  cashierUserId     String? // for finding existing report same day
  branchId          String?
  branch            Branch?      @relation(fields: [branchId], references: [id])
  companyId         String?
  cashierName       String
  date              DateTime     @db.Date // closing date
  openingCash       Float
  closingCash       Float
  expectedCash      Float
  cashDifference    Float
  totalTransactions Int          @default(0)
  totalSales        Float        @default(0)
  totalDiscount     Float        @default(0)
  totalTax          Float        @default(0)
  totalCashSales    Float        @default(0)
  totalNonCashSales Float        @default(0)
  cashMovementIn    Float        @default(0)
  cashMovementOut   Float        @default(0)
  voidCount         Int          @default(0)
  refundCount       Int          @default(0)
  paymentSummary    Json? // [{method, count, total}]
  notes             String?
  allowReopen       Boolean      @default(false) // admin sets true via reclosing to let cashier open new shift
  createdAt         DateTime     @default(now())

  @@index([branchId])
  @@index([companyId])
  @@index([date])
  @@index([branchId, date])
  @@index([cashierUserId, branchId, date])
  @@map("closing_reports")
}

model CashMovement {
  id        String           @id @default(uuid())
  shiftId   String
  shift     CashierShift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      CashMovementType
  amount    Float
  reason    String
  reference String?
  createdAt DateTime         @default(now())

  @@index([shiftId])
  @@map("cash_movements")
}

// ===========================
// EXPENSE
// ===========================

model Expense {
  id          String   @id @default(uuid())
  category    String
  description String
  amount      Float
  date        DateTime @default(now())
  companyId   String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([companyId])
  @@index([branchId])
  @@map("expenses")
}

// ===========================
// PROMO
// ===========================

model Promotion {
  id              String                    @id @default(uuid())
  name            String
  type            PromoType
  value           Float
  minPurchase     Float?
  maxDiscount     Float?
  scope           String                    @default("all") // "all", "product", "category"
  categoryId      String?
  category        Category?                 @relation(fields: [categoryId], references: [id])
  productId       String?
  product         Product?                  @relation(fields: [productId], references: [id])
  companyId       String
  company         Company                   @relation(fields: [companyId], references: [id])
  branchId        String?
  branch          Branch?                   @relation(fields: [branchId], references: [id])
  buyQty          Int? // BUY_X_GET_Y: buy this many
  getQty          Int? // BUY_X_GET_Y: get this many free
  getProductId    String? // BUY_X_GET_Y: free product id (null = same product)
  // Promo spesifik ke 1 SATUAN produk (mis. hanya satuan "bungkus"). null =
  // berlaku untuk semua satuan produk (backward-compat). Hanya relevan saat
  // scope="product" (productId di-set).
  unitId          String?
  unit            ProductUnit?              @relation(fields: [unitId], references: [id])
  voucherCode     String?                   @unique
  usageLimit      Int?
  usageCount      Int                       @default(0)
  description     String?
  isActive        Boolean                   @default(true)
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  vouchers        Voucher[]
  // Multi-trigger products (any-of). Saat di-set, engine cek kombinasi: customer
  // beli SALAH SATU produk dari list ini sudah memenuhi syarat. Backward-compat
  // dengan `productId` single-trigger — kalau triggerProducts kosong, engine
  // fallback ke productId/categoryId lama.
  triggerProducts PromotionTriggerProduct[] @relation("PromotionTriggers")
  // Multi-reward products (Tebus Murah). Customer dapat memilih SALAH SATU dari
  // produk-produk ini untuk ditebus. Engine generate 1 option per (promo,
  // getProduct). Backward-compat dengan `getProductId` single — kalau list
  // kosong, fallback ke kolom lama.
  getProducts     PromotionGetProduct[]     @relation("PromotionRewards")

  @@index([companyId])
  @@index([branchId])
  @@index([isActive, startDate, endDate])
  @@index([voucherCode])
  @@index([type])
  @@index([productId])
  @@index([categoryId])
  @@index([unitId])
  @@map("promotions")
}

// Join: 1 promo bisa punya banyak trigger product (any-of semantics).
// Customer beli SALAH SATU produk dari list ini → memenuhi syarat promo.
// Cocok untuk kasus tebus murah: "Beli A, B, C, atau D dapat tebus X".
model PromotionTriggerProduct {
  promoId   String
  promotion Promotion @relation("PromotionTriggers", fields: [promoId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation("ProductPromoTriggers", fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoId, productId])
  @@index([productId])
  @@map("promotion_trigger_products")
}

// Join: 1 promo bisa punya banyak produk tebus (multi-reward). Customer pilih
// SALAH SATU dari list ini untuk ditebus. Engine generate 1 option per produk.
model PromotionGetProduct {
  promoId   String
  promotion Promotion @relation("PromotionRewards", fields: [promoId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation("ProductPromoRewards", fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoId, productId])
  @@index([productId])
  @@map("promotion_get_products")
}

model Voucher {
  id          String    @id @default(uuid())
  code        String    @unique
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  isUsed      Boolean   @default(false)
  usedBy      String?
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([code])
  @@index([promotionId])
  @@map("vouchers")
}

// ===========================
// SETTINGS (dynamic key-value config)
// ===========================

model Setting {
  id        String   @id @default(uuid())
  key       String
  value     String // JSON string
  label     String?
  group     String?
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([key, branchId])
  @@index([group])
  @@index([branchId])
  @@map("settings")
}

// WA gateway dipindah ke service eksternal `wa-service` (HTTP + webhook).
// Tabel ini sekarang menyimpan:
//   1. Mapping company → tenant credentials di wa-service
//   2. Snapshot status terakhir (cache hasil webhook SESSION_UPDATED) supaya
//      query dashboard tidak harus selalu round-trip ke wa-service
// Kolom `authCreds` + tabel WhatsappSessionKey tetap ada untuk backward compat
// (data lama tidak di-drop), tapi sudah tidak di-populate lagi.
model WhatsappSession {
  id                    String               @id @default(uuid())
  companyId             String               @unique
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status                String               @default("DISCONNECTED") // DISCONNECTED, CONNECTING, CONNECTED
  stage                 String               @default("IDLE") // IDLE | PREPARING | QR_READY | SCANNED | SYNCING | CONNECTED | FAILED
  phoneNumber           String?
  deviceName            String?
  qrCode                String?
  authCreds             Json? // DEPRECATED: dulu Baileys creds; sekarang null. Tidak di-drop biar migration ringan.
  // ── wa-service tenant credentials ─────────────────────────────────
  waServiceTenantId     String?              @unique
  waServiceApiKey       String?
  waServiceWebhookSecret String?
  // ───────────────────────────────────────────────────────────────────
  lastConnectedAt       DateTime?
  lastDisconnectedAt    DateTime?
  lastError             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  keys                  WhatsappSessionKey[]
  messages              WhatsappMessageLog[]

  @@index([status])
  @@map("whatsapp_sessions")
}

model WhatsappSessionKey {
  id        String          @id @default(uuid())
  sessionId String
  session   WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  keyType   String
  keyId     String
  value     Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([sessionId, keyType, keyId])
  @@index([sessionId, keyType])
  @@map("whatsapp_session_keys")
}

model WhatsappMessageLog {
  id                String          @id @default(uuid())
  sessionId         String
  session           WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction         String // OUTBOUND, INBOUND
  toNumber          String?
  fromNumber        String?
  messageType       String          @default("text")
  content           String?
  status            String          @default("PENDING")
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime        @default(now())

  @@index([sessionId, createdAt])
  @@map("whatsapp_message_logs")
}

// Audit log percakapan AI Asisten (dashboard internal). Tiap query owner/staf
// dicatat: pertanyaan, jawaban, status (terjawab / tidak terjawab / error),
// tool yang dipanggil. Tujuan: audit pertanyaan yang TIDAK BISA dijawab AI
// supaya knowledge/tool bisa ditambah.
model AiAssistantLog {
  id           String   @id @default(uuid())
  companyId    String?
  userId       String
  userName     String?
  role         String?
  question     String // pertanyaan terakhir user
  answer       String? // jawaban AI (null kalau error)
  // ANSWERED  = AI menjawab dengan data
  // UNANSWERED = AI menjawab tapi tidak bisa/tdk punya akses (audit utama)
  // ERROR     = exception saat proses (audit utama)
  status       String   @default("ANSWERED")
  toolsUsed    String[] @default([]) // nama tool yang dipanggil
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("ai_assistant_logs")
}

// Konfigurasi chatbot WhatsApp per company. Bot punya 2 mode:
// - CUSTOMER: balas FAQ harga/jam buka, cek booking pribadi, daftar layanan
// - OWNER: cek stok produk, penjualan hari ini, booking hari ini, top product
// Mode ditentukan dari `fromNumber`:
// - cocok dengan salah satu `ownerPhones` → OWNER mode
// - selain itu → CUSTOMER mode (anonymous walaupun belum tercatat di Customer)
model WhatsappBotConfig {
  id                   String   @id @default(uuid())
  companyId            String   @unique
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enabled              Boolean  @default(false)
  // Daftar nomor (format normalized 62xxx) yang dianggap sebagai owner —
  // boleh akses tool data internal (stok, omset, dll). Kosong = tidak ada
  // owner mode, semua pengirim diperlakukan sebagai customer.
  ownerPhones          String[] @default([])
  // Pengetahuan bisnis bebas-format (jam buka, alamat, FAQ, kebijakan).
  // Di-stuff ke system prompt customer mode supaya bot bisa jawab tanpa
  // halusinasi. Kalau kosong, bot fallback minta admin manusia.
  knowledge            String?  @db.Text
  systemPromptCustomer String?  @db.Text
  systemPromptOwner    String?  @db.Text
  // Model Groq yang dipakai. Default ke openai/gpt-oss-120b karena
  // tool-calling-nya jauh lebih reliable. Llama-3 family kadang emit
  // native function-tag format yang bikin Groq parser fail.
  model                String   @default("openai/gpt-oss-120b")
  // Throttle balas: max 1 reply per nomor per N detik supaya tidak loop kalau
  // ada bot lain di seberang juga auto-reply.
  replyThrottleSec     Int      @default(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("whatsapp_bot_configs")
}

// ===========================
// MARKETPLACE INTEGRATION
// ===========================

/// Akun marketplace Shopee yang sudah ter-connect ke company. 1 company bisa
/// punya beberapa Shopee shop (mis. shop utama + shop branch). Token simpan
/// di sini, di-refresh otomatis tiap < 1 jam expire.
///
/// Auth flow: OAuth via Shopee Open Platform. App redirect seller ke Shopee
/// login → user authorize → callback dengan code → exchange code → dapat
/// access_token (4 jam) + refresh_token (30 hari).
model ShopeeAccount {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shopId           String // Shopee shop ID (numeric string)
  shopName         String? // Cached display name dari Shopee
  region           String    @default("ID") // ID/MY/SG/TH/VN/PH/TW/BR
  // Mode koneksi: OAUTH (resmi, butuh shop ≥30 order atau Mall) atau
  // COOKIE (PoC, paste cookie session dari browser seller).
  connectionMode   String    @default("OAUTH")
  // ─── OAuth fields (mode=OAUTH) ─────────────────────────────────
  accessToken      String?   @db.Text
  refreshToken     String?   @db.Text
  expiresAt        DateTime? // access_token expiry (~4 jam)
  refreshExpiresAt DateTime?
  // ─── Cookie fields (mode=COOKIE) ───────────────────────────────
  // Cookie string lengkap dari header Cookie request browser seller Shopee.
  // Format: "k1=v1; k2=v2; ...". Berisi token session yang valid 24-72 jam.
  // User wajib paste ulang saat expired.
  sellerCookie     String?   @db.Text
  // User-agent yang dipakai saat dapat cookie ini — beberapa cookie
  // ke-bind ke fingerprint browser, jadi disimpan untuk konsisten.
  cookieUserAgent  String?   @db.Text
  // Anti-bot tokens (mode=COOKIE, only untuk WRITE ops seperti update_stock,
  // update_product_info, create_product). Read ops gak butuh.
  // Struktur: { xSapRi, xSapSec, afAcEncSzToken, scFeSession, scFeVer }.
  // Tokens ini di-generate runtime oleh JS Shopee dan EXPIRE per session
  // (~15 menit s.d. beberapa jam). User wajib paste ulang saat expired.
  scrapingTokens   Json?
  // ─── Common ────────────────────────────────────────────────────
  isActive         Boolean   @default(true)
  lastSyncedAt     DateTime?
  lastError        String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  productMappings ProductMarketplaceMapping[]
  cachedItems     ShopeeItem[]

  @@unique([companyId, shopId])
  @@index([companyId])
  @@map("shopee_accounts")
}

/// Cache produk Shopee per akun. Setiap kali user "Refresh", semua item
/// dari Shopee di-upsert ke sini. UI tampil dari sini (instant, gak perlu
/// hit Shopee tiap buka halaman). Auto-match: saat upsert, kalau `sku` Shopee
/// match `Product.sku` di company yg sama, link `productId` otomatis.
///
/// Catatan: 1 Shopee item bisa punya beberapa model (varian). Untuk simplicity,
/// 1 ShopeeItem row = 1 (itemId, modelId) — produk dengan banyak varian akan
/// punya beberapa row.
model ShopeeItem {
  id              String        @id @default(uuid())
  shopeeAccountId String
  account         ShopeeAccount @relation(fields: [shopeeAccountId], references: [id], onDelete: Cascade)
  // Shopee item_id (int64) & model_id (int64). Disimpan sebagai string supaya
  // gak overflow JS Number. modelId NULL kalau produk tanpa varian (untuk
  // produk dengan model_list, selalu pakai model_id walaupun cuma 1 model).
  itemId          String
  // "0" untuk produk tanpa varian (atau yg model_id tidak ditemukan).
  // Non-nullable supaya composite unique [account, item, model] selalu unik
  // (PostgreSQL treat NULL != NULL di unique constraint).
  modelId         String        @default("0")
  name            String
  sku             String?
  status          String        @default("NORMAL")
  currentPrice    Int?
  originalPrice   Int?
  totalStock      Int?
  imageUrl        String?       @db.Text
  hasModel        Boolean       @default(false)
  // Link ke produk MiniPOS — NULL = belum linked. Auto-set saat fetch kalau
  // SKU match.
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  lastFetchedAt   DateTime      @default(now())
  lastPushedAt    DateTime? // Terakhir push stok ke Shopee
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([shopeeAccountId, itemId, modelId])
  @@index([shopeeAccountId])
  @@index([productId])
  @@map("shopee_items")
}

/// (RESERVED — belum dipakai). Mapping Product internal kita ↔ item di
/// marketplace. Belum implemented karena MVP cuma fetch-display, belum link
/// ke local Product. Tetap di-keep di schema supaya extension future
/// (mis. import Shopee item → buat Product baru di kita, atau sync stok)
/// tinggal pakai model ini tanpa migrasi schema.
model ProductMarketplaceMapping {
  id                   String         @id @default(uuid())
  productId            String
  product              Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // SHOPEE / TOKOPEDIA / LAZADA / TIKTOK_SHOP — pakai string supaya mudah
  // extend tanpa migrasi enum.
  marketplace          String
  // External item ID (Shopee item_id, Tokopedia product_id, dst).
  externalItemId       String
  // Variant level mapping (kalau product punya varian, masing-masing variant
  // di-link ke model_id Shopee). NULL = product-level mapping.
  externalModelId      String?
  externalSku          String?
  // Reference balik ke akun yang punya item ini (untuk Shopee).
  shopeeAccountId      String?
  shopeeAccount        ShopeeAccount? @relation(fields: [shopeeAccountId], references: [id], onDelete: Cascade)
  // Sinkronisasi status — last sync timestamp + last known stock di marketplace
  // (untuk reconciliation kalau ada discrepancy dengan stok kita).
  lastSyncedAt         DateTime?
  lastMarketplaceStock Int?
  syncEnabled          Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([marketplace, externalItemId, externalModelId])
  @@index([productId])
  @@index([shopeeAccountId])
  @@index([marketplace])
  @@map("product_marketplace_mappings")
}

// ===========================
// GRABFOOD INTEGRATION (Scraping-based, daily reporting only)
// ===========================
//
// Pattern serupa ShopeeAccount mode=COOKIE: user paste cookie dari Grab
// Merchant Portal, backend pakai untuk pull daily summary + order detail
// 1x sehari via cron. NOT untuk real-time order intake (lihat
// CATATAN_SHOPEE_API.md & Grab section di docs).
//
// 1 GrabAccount = 1 outlet GrabFood (multi-outlet per company supported).

model GrabAccount {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Branch MiniPOS yang outlet GrabFood ini "milik". Optional — kalau merchant
  // belum mapping branch, biarkan null dan tampil sebagai outlet standalone.
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // Grab merchantID (string, di-set saat paste cookie atau dari profile API).
  merchantId      String
  // Nama outlet untuk tampil di UI (cached dari Grab profile).
  merchantName    String?
  region          String    @default("ID") // ID/MY/SG/TH/VN/PH
  // ─── Cookie session (paste manual dari browser) ────────────────
  // Cookie lengkap dari header Cookie request browser merchant Grab.
  // Format: "k1=v1; k2=v2; ...". Berisi token session. Expire 1-4 jam
  // typical — user wajib paste ulang saat expired.
  cookie          String    @db.Text
  cookieUserAgent String?   @db.Text
  // Anti-bot tokens kalau Grab portal pakai (mis. x-csrf-token, x-grab-app).
  // Disimpan terpisah supaya bisa di-refresh tanpa replace cookie.
  scrapingTokens  Json?
  // ─── Status ────────────────────────────────────────────────────
  isActive        Boolean   @default(true)
  lastSyncedAt    DateTime?
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyReports GrabDailyReport[]
  orders       GrabOrder[]

  @@unique([companyId, merchantId])
  @@index([companyId])
  @@index([branchId])
  @@map("grab_accounts")
}

/// Summary harian per outlet GrabFood. Cron daily upsert 1 row per
/// (account, reportDate). Reportable di dashboard MiniPOS untuk
/// rekonsiliasi keuangan & sales analytics.
model GrabDailyReport {
  id             String      @id @default(uuid())
  accountId      String
  account        GrabAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Tanggal report (date only, no time). UTC date — convert ke WIB di UI.
  reportDate     DateTime    @db.Date
  // Aggregate metrics (semua dalam rupiah, integer untuk hindari floating point).
  orderCount     Int         @default(0)
  completedCount Int         @default(0)
  cancelledCount Int         @default(0)
  // GMV (gross merchandise value) = total nominal order sebelum potongan
  grossSales     Int         @default(0)
  // Net payout = GMV - Grab commission - refund. Match dengan settlement Grab.
  netPayout      Int         @default(0)
  // Grab commission (fee Grab ambil). Biasanya 20-30% di Indonesia.
  commission     Int         @default(0)
  // Refund total kalau ada return/cancel after charge.
  refundAmount   Int         @default(0)
  // Raw response dari Grab portal (untuk debug & schema migration nanti).
  rawPayload     Json?
  fetchedAt      DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([accountId, reportDate])
  @@index([accountId, reportDate])
  @@map("grab_daily_reports")
}

/// Detail order individual dari GrabFood. Cron daily upsert order yang
/// completed/cancelled di hari sebelumnya. Pending/active orders skip —
/// karena real-time integration butuh Partner API resmi.
model GrabOrder {
  id            String      @id @default(uuid())
  accountId     String
  account       GrabAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Grab order_id / short_order_id — public visible di app customer.
  grabOrderId   String
  shortOrderId  String?
  // ─── Customer (sebagian masked Grab — biasanya cuma nama depan & nomor masked) ─
  customerName  String?
  customerPhone String? // biasanya masked "0812****1234"
  // ─── Money (dalam rupiah, integer) ─────────────────────────────
  subtotal      Int         @default(0)
  deliveryFee   Int         @default(0)
  discount      Int         @default(0)
  total         Int         @default(0) // total yang dibayar customer
  commission    Int         @default(0) // Grab cut
  netPayout     Int         @default(0) // yang merchant terima
  // ─── Status ──────────────────────────────────────────────────────
  // COMPLETED, CANCELLED, REFUNDED, PENDING — string supaya extend mudah
  status        String      @default("COMPLETED")
  paymentMethod String? // GRABPAY, OVO, CASH, etc.
  cancelReason  String?
  // ─── Items ─────────────────────────────────────────────────────
  // Disimpan sebagai JSON karena schema item Grab bervariasi & kita gak
  // butuh query per-item (cuma display). Format:
  // [{ name, qty, price, modifiers: [{name, price}], note }]
  items         Json?
  itemCount     Int         @default(0)
  // ─── Timing ────────────────────────────────────────────────────
  orderedAt     DateTime?
  acceptedAt    DateTime?
  readyAt       DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  // ─── Raw payload untuk reference / future re-parse ─────────────
  rawPayload    Json?
  fetchedAt     DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([accountId, grabOrderId])
  @@index([accountId, status])
  @@index([accountId, orderedAt])
  @@map("grab_orders")
}

// ===========================
// BENGKEL — Vehicle, Service Order
// ===========================

model Vehicle {
  id              String         @id @default(uuid())
  companyId       String
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Identitas kendaraan
  plateNumber     String
  type            String         @default("MOTOR") // MOTOR, MOBIL
  // Brand (FK ke Brand dengan kind=VEHICLE) — mis. Honda, Yamaha, Toyota.
  brandId         String?
  brand           Brand?         @relation("VehicleBrand", fields: [brandId], references: [id])
  // Model (FK ke Category dengan kind=VEHICLE_MODEL) — mis. Vario 150, Beat.
  // Tiap model di-link ke brand-nya, sehingga form bisa cascade.
  modelId         String?
  modelRef        Category?      @relation("VehicleModel", fields: [modelId], references: [id])
  year            Int?
  color           String?
  vin             String? // No rangka
  engineNumber    String?
  engineCapacity  String? // 150cc, 1.5L
  transmission    String? // manual / automatic
  fuelType        String? // pertalite, pertamax, solar
  mileage         Int? // odometer terakhir (km)
  photoUrl        String?
  notes           String?
  isActive        Boolean        @default(true)
  lastServicedAt  DateTime?
  nextServiceKm   Int?
  nextServiceDate DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  serviceOrders   ServiceOrder[]

  bookings Booking[]

  @@unique([companyId, plateNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([plateNumber])
  @@index([brandId])
  @@index([modelId])
  @@map("vehicles")
}

// ===========================
// BOOKING — universal reservation/appointment
// ===========================
//
// Satu model untuk semua bisnis unit:
//  - Bengkel  → service appointment (vehicleId, serviceType, mechanicId)
//  - Resto/Cafe → table reservation (partySize, tableId)
// Field opsional di-isi sesuai bookingType. Status workflow:
//   PENDING → CONFIRMED → IN_PROGRESS → COMPLETED
//   atau CANCELLED / NO_SHOW dari status manapun.
model Booking {
  id             String           @id @default(uuid())
  companyId      String
  branchId       String
  branch         Branch           @relation(fields: [branchId], references: [id])
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  // Identitas customer kalau bukan member (walk-in booking).
  customerName   String?
  customerPhone  String?
  // BENGKEL | RESTAURANT | CAFE — menentukan field opsional yang relevan.
  bookingType    String
  // Jadwal kedatangan / janji.
  scheduledAt    DateTime
  durationMin    Int? // estimasi durasi pelayanan
  // Status: PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  status         String           @default("PENDING")
  notes          String?
  // ─── Bengkel-specific ──────────────────────────────────────────
  vehicleId      String?
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id])
  serviceType    String? // Ganti Oli, Tune Up, dll
  mechanicId     String?
  mechanic       User?            @relation("BookingMechanic", fields: [mechanicId], references: [id])
  // ─── Resto/Cafe-specific ───────────────────────────────────────
  partySize      Int?
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  // Reminder WA tracking — supaya cron tidak dobel kirim.
  reminderSentAt DateTime?
  // Saat di-finalize jadi service order (bengkel) atau table session (F&B),
  // simpan reference-nya di sini untuk audit.
  serviceOrderId String?
  cancelReason   String?
  cancelledAt    DateTime?
  completedAt    DateTime?
  createdById    String?
  createdBy      User?            @relation("BookingCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([mechanicId])
  @@index([tableId])
  @@index([status])
  @@index([scheduledAt])
  @@index([branchId, scheduledAt])
  @@map("bookings")
}

model ServiceOrder {
  id                 String             @id @default(uuid())
  // Unique scoped per company — sequence reset per company per hari.
  orderNumber        String
  companyId          String
  branchId           String
  branch             Branch             @relation(fields: [branchId], references: [id])
  vehicleId          String
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id])
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id])
  // Mekanik utama yang assigned (boleh null kalau belum di-assign).
  mechanicId         String?
  mechanic           User?              @relation("ServiceOrderMechanic", fields: [mechanicId], references: [id])
  // Status: ANTRIAN, DIAGNOSA, MENUNGGU_APPROVAL, DIKERJAKAN, SELESAI, DIBAYAR, DIBATALKAN
  status             String             @default("ANTRIAN")
  complaint          String? // Keluhan customer
  diagnose           String? // Hasil diagnosa mekanik
  estimateAmount     Float?
  finalAmount        Float? // Total final yg disepakati
  mileageIn          Int?
  mileageOut         Int?
  approvedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  // Estimasi tanggal service berikutnya — di-set saat finalize, dipakai oleh
  // cron reminder WA (H-7 / H-3 sebelum tanggal ini).
  nextServiceAt      DateTime?
  // Stempel waktu terakhir reminder dikirim, supaya tidak dobel di window
  // yang sama (H-7 → tidak dikirim ulang sampai pindah window H-3).
  lastReminderSentAt DateTime?
  // Foto sebelum/sesudah, attachment lain. Format: [{url, label, uploadedAt}]
  attachments        Json?
  notes              String?
  // Link ke Transaction setelah dibayar (1:1 — Service Order finalize jadi Transaction).
  transactionId      String?            @unique
  transaction        Transaction?       @relation("ServiceOrderTransaction", fields: [transactionId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  items              ServiceOrderItem[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([mechanicId])
  @@index([status])
  @@index([createdAt])
  @@index([branchId, status, createdAt])
  // Index untuk cron reminder: filter SO yang sudah punya jadwal & belum
  // selesai window-nya.
  @@index([nextServiceAt, lastReminderSentAt])
  @@map("service_orders")
}

model ServiceOrderItem {
  id               String       @id @default(uuid())
  serviceOrderId   String
  serviceOrder     ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  // Kalau item = produk dari katalog, isi productId. Kalau jasa ad-hoc
  // (mis. "Pengecekan suspensi"), productId null + name diisi manual.
  productId        String?
  // PRODUCT atau SERVICE — duplikasi dari Product.itemType supaya tidak
  // butuh JOIN di list view. Default SERVICE supaya UI default ke "jasa".
  itemType         String       @default("SERVICE")
  name             String
  quantity         Float        @default(1)
  unitPrice        Float
  discount         Float        @default(0)
  subtotal         Float
  // Mekanik yang nge-handle item ini (untuk komisi). Bisa beda dengan
  // mekanik utama di ServiceOrder kalau ada lebih dari 1 mekanik.
  mechanicId       String?
  mechanic         User?        @relation("ServiceOrderItemMechanic", fields: [mechanicId], references: [id])
  // Untuk JASA: persen komisi yang akan dihitung. Default 0.
  commissionPct    Float        @default(0)
  // Computed dari subtotal × commissionPct/100 saat finalize. Disimpan
  // supaya laporan komisi tidak butuh re-compute.
  commissionAmount Float        @default(0)
  notes            String?
  createdAt        DateTime     @default(now())

  @@index([serviceOrderId])
  @@index([productId])
  @@index([mechanicId])
  @@map("service_order_items")
}

// ===========================
// AUDIT
// ===========================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([branchId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  description String?
  metadata    String? // JSON
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ===========================
// HUTANG PIUTANG (Debt & Receivable)
// ===========================

model Debt {
  id              String        @id @default(uuid())
  type            DebtType // PAYABLE (hutang - kita berhutang) or RECEIVABLE (piutang - orang lain berhutang ke kita)
  referenceType   String? // "TRANSACTION", "PURCHASE", "OTHER"
  referenceId     String? // linked transaction or purchase order ID
  partyType       String // "CUSTOMER" or "SUPPLIER" or "OTHER"
  partyId         String? // customer or supplier ID
  partyName       String // name for display
  description     String?
  totalAmount     Float // total debt amount
  paidAmount      Float         @default(0) // how much has been paid
  remainingAmount Float // totalAmount - paidAmount
  status          DebtStatus    @default(UNPAID)
  dueDate         DateTime?
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  companyId       String?
  createdBy       String
  creator         User          @relation(fields: [createdBy], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payments        DebtPayment[]
  installments    Installment[]

  // Installment plan config (null = no installment plan)
  downPayment         Float? // DP amount
  installmentCount    Int? // number of installments
  installmentInterval String? // "WEEKLY" or "MONTHLY"

  @@index([type])
  @@index([status])
  @@index([partyId])
  @@index([branchId])
  @@index([createdAt])
  @@index([dueDate])
  @@index([branchId, status])
  @@index([branchId, type, status])
  @@map("debts")
}

model DebtPayment {
  id     String   @id @default(uuid())
  debtId String
  debt   Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount Float
  method String   @default("CASH") // CASH, TRANSFER, etc
  notes  String?
  paidBy String
  payer  User     @relation(fields: [paidBy], references: [id])
  paidAt DateTime @default(now())

  @@index([debtId])
  @@map("debt_payments")
}

model Installment {
  id            String    @id @default(uuid())
  debtId        String
  debt          Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  installmentNo Int // 1, 2, 3, ...
  amount        Float // nominal per cicilan
  dueDate       DateTime // jatuh tempo cicilan ini
  paidAmount    Float     @default(0)
  paidAt        DateTime? // tanggal lunas
  status        String    @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([debtId, installmentNo])
  @@index([debtId])
  @@index([dueDate])
  @@index([status])
  @@map("installments")
}

enum DebtType {
  PAYABLE // Hutang (kita berhutang ke supplier/orang lain)
  RECEIVABLE // Piutang (customer/orang lain berhutang ke kita)
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

// ===========================
// RETURN & EXCHANGE
// ===========================

model ReturnExchange {
  id              String               @id @default(uuid())
  returnNumber    String               @unique
  transactionId   String
  transaction     Transaction          @relation(fields: [transactionId], references: [id])
  customerId      String?
  customer        Customer?            @relation(fields: [customerId], references: [id])
  type            String // RETURN, EXCHANGE
  status          String               @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  reason          String
  notes           String?
  totalRefund     Float                @default(0)
  refundMethod    String? // CASH, STORE_CREDIT, ORIGINAL_METHOD
  approvedBy      String?
  approvedAt      DateTime?
  branchId        String?
  branch          Branch?              @relation(fields: [branchId], references: [id])
  processedBy     String
  processedByUser User                 @relation("ReturnProcessedBy", fields: [processedBy], references: [id])
  items           ReturnExchangeItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([transactionId])
  @@index([returnNumber])
  @@map("return_exchanges")
}

model ReturnExchangeItem {
  id                String         @id @default(uuid())
  returnExchangeId  String
  returnExchange    ReturnExchange @relation(fields: [returnExchangeId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  productName       String
  quantity          Int
  unitPrice         Float
  subtotal          Float
  reason            String?
  // For exchange: replacement product
  exchangeProductId String?
  exchangeProduct   Product?       @relation("ExchangeProduct", fields: [exchangeProductId], references: [id])
  exchangeQuantity  Int?
  restocked         Boolean        @default(false)

  @@index([returnExchangeId])
  @@map("return_exchange_items")
}

// ===========================
// GIFT CARDS
// ===========================

model GiftCard {
  id             String                @id @default(uuid())
  code           String                @unique
  initialBalance Float
  currentBalance Float
  status         String                @default("ACTIVE") // ACTIVE, USED, EXPIRED, DISABLED
  purchasedBy    String? // customer name or walk-in
  customerId     String?
  customer       Customer?             @relation(fields: [customerId], references: [id])
  expiresAt      DateTime?
  companyId      String?
  branchId       String?
  branch         Branch?               @relation(fields: [branchId], references: [id])
  createdBy      String
  createdByUser  User                  @relation("GiftCardCreatedBy", fields: [createdBy], references: [id])
  transactions   GiftCardTransaction[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([code])
  @@index([companyId])
  @@index([customerId])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id            String   @id @default(uuid())
  giftCardId    String
  giftCard      GiftCard @relation(fields: [giftCardId], references: [id])
  type          String // PURCHASE, REDEEM, TOPUP, REFUND
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  reference     String? // invoice number or note
  createdAt     DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_transactions")
}

// ===========================
// SALES TARGET & GAMIFICATION
// ===========================

model SalesTarget {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  type          String // DAILY, WEEKLY, MONTHLY
  targetRevenue Float?
  targetTx      Int? // target transaction count
  targetItems   Int? // target items sold
  period        String // e.g. "2026-04", "2026-W14", "2026-04-04"
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, type, period])
  @@index([period])
  @@map("sales_targets")
}

model CashierBadge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  badge       String // TOP_SELLER, ZERO_VOID, SPEED_DEMON, STREAK_7, etc.
  title       String
  description String?
  earnedAt    DateTime @default(now())
  period      String? // period when earned

  @@index([userId])
  @@map("cashier_badges")
}

// ===========================
// EMPLOYEE SCHEDULER
// ===========================

model EmployeeSchedule {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  date       DateTime @db.Date
  shiftStart String // "08:00"
  shiftEnd   String // "16:00"
  shiftLabel String? // "Pagi", "Siang", "Malam"
  status     String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, ABSENT, LEAVE
  notes      String?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([branchId, date])
  @@map("employee_schedules")
}

// ===========================
// KITCHEN / ORDER DISPLAY
// ===========================

model OrderQueue {
  id            String           @id @default(uuid())
  queueNumber   Int
  transactionId String?
  transaction   Transaction?     @relation(fields: [transactionId], references: [id])
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id])
  status        String           @default("NEW") // NEW, PREPARING, READY, SERVED, CANCELLED
  priority      Int              @default(0)
  notes         String?
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  items         OrderQueueItem[]
  tableOrders   TableOrder[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  servedAt      DateTime?

  @@index([branchId, status])
  @@index([createdAt])
  @@map("order_queues")
}

model OrderQueueItem {
  id           String     @id @default(uuid())
  orderQueueId String
  orderQueue   OrderQueue @relation(fields: [orderQueueId], references: [id], onDelete: Cascade)
  productName  String
  quantity     Int
  notes        String?
  status       String     @default("PENDING") // PENDING, PREPARING, DONE

  @@index([orderQueueId])
  @@map("order_queue_items")
}

// ===========================
// CASHIER FAVORITES (POS Quick Access)
// ===========================

model CashierFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("cashier_favorites")
}

// ===========================
// ACCOUNTING MODULE
// ===========================

model AccountCategory {
  id         String    @id @default(uuid())
  name       String // Aset, Kewajiban, Modal, Pendapatan, Beban
  type       String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  normalSide String // DEBIT, CREDIT
  sortOrder  Int       @default(0)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  accounts   Account[]
  createdAt  DateTime  @default(now())

  @@unique([companyId, type])
  @@index([companyId])
  @@map("account_categories")
}

model Account {
  id                  String                 @id @default(uuid())
  code                String // e.g. 1-1001
  name                String
  description         String?
  categoryId          String
  category            AccountCategory        @relation(fields: [categoryId], references: [id])
  parentId            String?
  parent              Account?               @relation("AccountHierarchy", fields: [parentId], references: [id])
  children            Account[]              @relation("AccountHierarchy")
  isActive            Boolean                @default(true)
  isSystem            Boolean                @default(false) // System accounts can't be deleted
  branchId            String? // null = global account
  branch              Branch?                @relation(fields: [branchId], references: [id])
  openingBalance      Float                  @default(0)
  journalLines        JournalEntryLine[]
  recurringLines      RecurringJournalLine[]
  bankReconciliations BankReconciliation[]   @relation("BankReconAccount")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([categoryId])
  @@index([parentId])
  @@index([code])
  @@index([branchId])
  @@map("accounts")
}

model JournalEntry {
  id             String             @id @default(uuid())
  entryNumber    String             @unique // JV-260404-0001
  date           DateTime           @db.Date
  description    String
  reference      String? // invoice number, PO number, etc.
  referenceType  String? // TRANSACTION, PURCHASE, RETURN, DEBT_PAYMENT, EXPENSE, MANUAL
  referenceId    String? // ID of related entity
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  periodId       String?
  period         AccountingPeriod?  @relation(fields: [periodId], references: [id])
  status         String             @default("POSTED") // DRAFT, PENDING_APPROVAL, POSTED, VOIDED
  totalDebit     Float              @default(0)
  totalCredit    Float              @default(0)
  lines          JournalEntryLine[]
  createdBy      String
  createdByUser  User               @relation("JournalCreatedBy", fields: [createdBy], references: [id])
  approvedBy     String?
  approvedByUser User?              @relation("JournalApprovedBy", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  rejectionNote  String?
  updatedBy      String?
  notes          String?
  changeLogs     JournalChangeLog[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([date])
  @@index([entryNumber])
  @@index([referenceType, referenceId])
  @@index([branchId])
  @@index([periodId])
  @@index([status])
  @@index([status, date])
  @@index([branchId, status, date, createdAt])
  @@map("journal_entries")
}

model JournalEntryLine {
  id            String       @id @default(uuid())
  journalId     String
  journal       JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  description   String?
  debit         Float        @default(0)
  credit        Float        @default(0)
  taxType       String? // PPN_KELUARAN, PPN_MASUKAN, PPH21, PPH23
  taxAmount     Float?       @default(0)
  taxBaseAmount Float?       @default(0) // DPP (Dasar Pengenaan Pajak)
  sortOrder     Int          @default(0)

  @@index([journalId])
  @@index([accountId])
  @@index([journalId, sortOrder])
  @@index([accountId, journalId])
  @@map("journal_entry_lines")
}

model AccountingPeriod {
  id        String         @id @default(uuid())
  name      String // "April 2026"
  startDate DateTime       @db.Date
  endDate   DateTime       @db.Date
  status    String         @default("OPEN") // OPEN, CLOSED, LOCKED
  closedBy  String?
  closedAt  DateTime?
  companyId String?
  journals  JournalEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([startDate, endDate, companyId])
  @@index([status])
  @@index([companyId])
  @@map("accounting_periods")
}

model JournalChangeLog {
  id        String       @id @default(uuid())
  journalId String
  journal   JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  action    String // CREATED, UPDATED, SUBMITTED, APPROVED, REJECTED, POSTED, VOIDED
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  changes   String? // JSON: { field: { old, new } }
  snapshot  String? // JSON: full journal state at time of action
  ipAddress String?
  createdAt DateTime     @default(now())

  @@index([journalId])
  @@index([userId])
  @@index([createdAt])
  @@map("journal_change_logs")
}

model RecurringJournalTemplate {
  id            String                 @id @default(uuid())
  name          String
  description   String?
  frequency     String // MONTHLY, QUARTERLY, YEARLY
  dayOfMonth    Int?                   @default(1)
  nextRunDate   DateTime               @db.Date
  lastRunDate   DateTime?              @db.Date
  isActive      Boolean                @default(true)
  branchId      String?
  branch        Branch?                @relation(fields: [branchId], references: [id])
  companyId     String
  company       Company                @relation(fields: [companyId], references: [id])
  createdBy     String
  createdByUser User                   @relation(fields: [createdBy], references: [id])
  lines         RecurringJournalLine[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([companyId, isActive])
  @@index([nextRunDate])
  @@map("recurring_journal_templates")
}

model RecurringJournalLine {
  id          String                   @id @default(uuid())
  templateId  String
  template    RecurringJournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account                  @relation(fields: [accountId], references: [id])
  description String?
  debit       Float                    @default(0)
  credit      Float                    @default(0)
  sortOrder   Int                      @default(0)

  @@index([templateId])
  @@map("recurring_journal_lines")
}

model BankReconciliation {
  id               String                   @id @default(uuid())
  accountId        String
  account          Account                  @relation("BankReconAccount", fields: [accountId], references: [id])
  statementDate    DateTime                 @db.Date
  statementBalance Float
  bookBalance      Float                    @default(0)
  status           String                   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  companyId        String
  company          Company                  @relation(fields: [companyId], references: [id])
  completedBy      String?
  completedAt      DateTime?
  items            BankReconciliationItem[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([companyId])
  @@index([accountId, statementDate])
  @@map("bank_reconciliations")
}

model BankReconciliationItem {
  id               String             @id @default(uuid())
  reconciliationId String
  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  source           String // BANK_STATEMENT, JOURNAL
  referenceNumber  String?
  description      String
  date             DateTime           @db.Date
  amount           Float
  matchedItemId    String?
  matchStatus      String             @default("UNMATCHED") // UNMATCHED, MATCHED, ADJUSTED
  journalEntryId   String?
  createdAt        DateTime           @default(now())

  @@index([reconciliationId])
  @@index([matchStatus])
  @@map("bank_reconciliation_items")
}

// ===========================
// RECIPES (BOM untuk F&B)
// ===========================
//
// Konsep: satu Product (mis. menu "Nasi Goreng") punya 1 Recipe yg merangkai
// daftar ingredient (Product lain yg di-stock sebagai bahan baku — beras,
// telur, ayam, dst). Saat menu tsb dijual, transaction service expand recipe
// → decrement stok bahan baku, bukan stok menu. Cocok untuk restoran/cafe
// di mana stok menu sebenarnya = ketersediaan bahan-bahan-nya.
//
// `yieldQty` = berapa porsi dihasilkan dari 1 batch resep. Default 1 (1
// resep = 1 porsi). Kalau resep "kuah soto 1 panci = 8 porsi", set 8 — qty
// ingredient akan dibagi yieldQty saat decrement.

model Recipe {
  id          String             @id @default(uuid())
  productId   String             @unique
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  yieldQty    Float              @default(1)
  notes       String?
  ingredients RecipeIngredient[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("recipes")
}

model RecipeIngredient {
  id           String   @id @default(uuid())
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Product  @relation("RecipeIngredient", fields: [ingredientId], references: [id])
  quantity     Float
  unit         String   @default("pcs")
  notes        String?
  createdAt    DateTime @default(now())

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

// ===========================
// PRODUCT BUNDLES
// ===========================

model ProductBundle {
  id             String              @id @default(uuid())
  code           String              @unique
  name           String
  description    String?
  imageUrl       String?
  sellingPrice   Float // Bundle price (usually discounted)
  totalBasePrice Float               @default(0) // Sum of component prices (for margin calculation)
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id])
  isActive       Boolean             @default(true)
  barcode        String?             @unique
  items          ProductBundleItem[]
  companyId      String?
  branchId       String?
  branch         Branch?             @relation(fields: [branchId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([isActive])
  @@index([categoryId])
  @@index([companyId])
  @@index([branchId])
  @@map("product_bundles")
}

model ProductBundleItem {
  id        String        @id @default(uuid())
  bundleId  String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int           @default(1)
  sortOrder Int           @default(0)

  @@index([bundleId])
  @@index([productId])
  @@map("product_bundle_items")
}

// ===========================
// RESTAURANT TABLES
// ===========================

model RestaurantTable {
  id        String   @id @default(uuid())
  number    Int
  name      String? // e.g. "Meja VIP 1", "Outdoor 3"
  capacity  Int      @default(4)
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  // Meja virtual untuk order online/WhatsApp. Saat true, satu meja menampung
  // banyak customer sekaligus — sesi di-scope per customerPhone (bukan 1 sesi
  // per meja seperti meja fisik).
  isOnline  Boolean  @default(false)
  sortOrder Int      @default(0)
  section   String? // e.g. "Indoor", "Outdoor", "VIP"
  qrToken   String?  @unique // public token for tablet ordering URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions  Transaction[]
  orderQueues   OrderQueue[]
  tableSessions TableSession[]
  tableOrders   TableOrder[]
  bookings      Booking[]

  @@unique([number, branchId])
  @@index([branchId, status])
  @@index([section])
  @@map("restaurant_tables")
}

// ===========================
// SELF-ORDER (Table Tablet Ordering)
// ===========================
//
// One open TableSession per table groups multiple TableOrder submissions
// into a single bill. Customer can keep ordering while session is OPEN.
// Session is closed when payment is settled (online or via kasir) OR
// when kasir manually closes it.

model TableSession {
  id            String          @id @default(uuid())
  tableId       String
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  status        String          @default("OPEN") // OPEN, AWAITING_PAYMENT, CLOSED
  customerName  String?
  customerPhone String?
  subtotal      Float           @default(0)
  paidAmount    Float           @default(0)
  transactionId String?         @unique
  transaction   Transaction?    @relation(fields: [transactionId], references: [id])
  openedAt      DateTime        @default(now())
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  orders   TableOrder[]
  payments TableSessionPayment[]

  @@index([branchId, status])
  @@index([tableId, status])
  @@map("table_sessions")
}

model TableOrder {
  id             String          @id @default(uuid())
  sessionId      String
  session        TableSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tableId        String
  table          RestaurantTable @relation(fields: [tableId], references: [id])
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  status         String          @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, SENT_TO_KITCHEN, READY, SERVED, CANCELLED
  total          Float           @default(0)
  customerNote   String?
  rejectReason   String?
  approvedBy     String?
  approvedByUser User?           @relation(fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  orderQueueId   String? // link to KDS queue once approved
  orderQueue     OrderQueue?     @relation(fields: [orderQueueId], references: [id])
  // Device identification — UUID stored in customer's localStorage saat
  // first visit. Dipakai backend filter session.orders supaya tiap device
  // hanya lihat order yang dibuatnya. Nullable untuk backward-compat.
  deviceId       String?
  // Denormalized customerPhone per-order (instead of relying on
  // session-level phone) supaya phone-based recovery match per-order
  // walaupun session.customerPhone berbeda.
  customerPhone  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items TableOrderItem[]

  @@index([branchId, status])
  @@index([sessionId])
  @@index([tableId, status])
  @@index([createdAt])
  @@index([deviceId])
  @@index([customerPhone])
  @@map("table_orders")
}

model TableOrderItem {
  id          String     @id @default(uuid())
  orderId     String
  order       TableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  productName String // snapshot at time of order
  qty         Int
  unitPrice   Float
  subtotal    Float
  note        String?

  @@index([orderId])
  @@index([productId])
  @@map("table_order_items")
}

// Foundation for online payments. Provider implementations come later;
// service code only writes generic fields here.
model TableSessionPayment {
  id         String       @id @default(uuid())
  sessionId  String
  session    TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  provider   String // QRIS, MIDTRANS, XENDIT, MANUAL
  channel    String? // e.g. GOPAY, OVO, BANK_TRANSFER
  amount     Float
  status     String       @default("PENDING") // PENDING, PAID, FAILED, EXPIRED, REFUNDED
  externalId String? // gateway transaction reference
  rawPayload Json? // gateway-specific payload
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([sessionId])
  @@index([provider, externalId])
  @@map("table_session_payments")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("email_verification_tokens")
}

model PhoneVerificationToken {
  id        String   @id @default(uuid())
  phone     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([token])
  @@map("phone_verification_tokens")
}

model SubscriptionPayment {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  plan           String // PRO, ENTERPRISE
  amount         Float
  durationMonths Int
  billingType    String    @default("MONTHLY") // MONTHLY, YEARLY
  status         String    @default("PAID") // PAID, PENDING, REFUNDED, CANCELLED
  planStartDate  DateTime
  planEndDate    DateTime
  notes          String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([companyId])
  @@index([status])
  @@map("subscription_payments")
}

model PlanMenuAccess {
  id      String  @id @default(uuid())
  plan    String // FREE, PRO, ENTERPRISE
  menuKey String // references AppMenu.key
  allowed Boolean @default(false)

  @@unique([plan, menuKey])
  @@index([plan])
  @@map("plan_menu_access")
}

model PlanActionAccess {
  id        String  @id @default(uuid())
  plan      String // FREE, PRO, ENTERPRISE
  menuKey   String
  actionKey String
  allowed   Boolean @default(false)

  @@unique([plan, menuKey, actionKey])
  @@index([plan])
  @@map("plan_action_access")
}

model PaymentOrder {
  id              String             @id @default(uuid())
  companyId       String
  transactionId   String?
  transaction     Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  provider        String             @default("xendit")
  // ID yang kita kirim ke Xendit sebagai external_id (unik global).
  externalId      String             @unique
  // ID dari sisi Xendit (dari response create) — disimpan saat tahu.
  providerOrderId String?
  status          PaymentOrderStatus @default(PENDING)
  amount          Int
  currency        String             @default("IDR")
  description     String?
  payerEmail      String?
  paymentUrl      String?
  // Method final yang dipilih customer di halaman Xendit (BCA/QRIS/OVO/dst).
  paymentMethod   String?
  paymentChannel  String?
  paidAt          DateTime?
  expiresAt       DateTime?
  failureReason   String?
  rawCreate       Json?
  rawCallback     Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([companyId])
  @@index([transactionId])
  @@index([status])
  @@index([provider, providerOrderId])
  @@map("payment_orders")
}

// ===========================
// RAK / BIN LOCATION INVENTORY
// ===========================

model Rack {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  location  String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rackStocks         RackStock[]
  fromMovements      RackStockMovement[] @relation("FromRack")
  toMovements        RackStockMovement[] @relation("ToRack")
  defaultForProducts Product[]           @relation("ProductDefaultRack")
  discrepancies      RackDiscrepancy[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([companyId])
  @@map("racks")
}

model RackStock {
  id        String   @id @default(uuid())
  rackId    String
  rack      Rack     @relation(fields: [rackId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qty       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rackId, productId])
  @@index([productId, branchId])
  @@index([rackId])
  @@map("rack_stocks")
}

model RackStockMovement {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  fromRackId String?
  fromRack   Rack?    @relation("FromRack", fields: [fromRackId], references: [id])
  toRackId   String?
  toRack     Rack?    @relation("ToRack", fields: [toRackId], references: [id])
  qty        Int
  type       String
  refType    String?
  refId      String?
  byUserId   String?
  byUser     User?    @relation(fields: [byUserId], references: [id])
  notes      String?
  createdAt  DateTime @default(now())

  @@index([productId, branchId])
  @@index([fromRackId])
  @@index([toRackId])
  @@index([createdAt])
  @@map("rack_stock_movements")
}

// Phase 3: laporan stok hilang / selisih per rak. User lapor "harusnya N,
// aktual M" → buat record, auto-create adjustment (kalau diizinkan),
// notif admin. Admin bisa investigate sebelum apply.
model RackDiscrepancy {
  id               String    @id @default(uuid())
  rackId           String
  rack             Rack      @relation(fields: [rackId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  branchId         String
  branch           Branch    @relation(fields: [branchId], references: [id])
  companyId        String
  expectedQty      Int
  actualQty        Int
  difference       Int
  status           String    @default("OPEN") // OPEN | RESOLVED
  notes            String?
  reportedByUserId String
  reportedBy       User      @relation("DiscrepancyReporter", fields: [reportedByUserId], references: [id])
  reportedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?     @relation("DiscrepancyResolver", fields: [resolvedByUserId], references: [id])

  @@index([rackId])
  @@index([productId])
  @@index([companyId, status])
  @@index([reportedAt])
  @@map("rack_discrepancies")
}
