# Database (Supabase / Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT
JWT_SECRET="generate-via-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# Redis (optional)
REDIS_URL=""

# Cloudinary (uploads)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Pusher (realtime, optional)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Resend (email, optional)
RESEND_API_KEY=""

# Groq AI (optional)
GROQ_API_KEY=""

# ─── ID MODEL AI (semua provider) ─────────────────────────────────────────────
# Provider free-tier rutin men-decommission model tanpa pemberitahuan, dan itu
# membuat fitur AI mati SENYAP. Semua ID model karena itu dibaca dari env
# (backend/src/common/ai/ai-models.ts) — kalau ada yang mati cukup ganti di sini
# lalu restart, tanpa ubah kode. Kosongkan untuk memakai default di kode.
#
# Cek model yang masih hidup:
#   Groq       : GET https://api.groq.com/openai/v1/models  (pakai Authorization)
#   OpenRouter : GET https://openrouter.ai/api/v1/models
GROQ_MODEL=""
GROQ_FALLBACK_MODELS=""
GROQ_NORMALIZE_MODEL=""
GROQ_VISION_MODEL=""
GROQ_DESCRIPTION_MODEL=""
WHATSAPP_BOT_MODEL=""

# Google AI Studio (Gemini) — fallback saat semua model Groq rate-limited.
GEMINI_API_KEY=""
GEMINI_MODEL=""

# OpenRouter (gateway multi-model, dipakai untuk vision)
OPENROUTER_API_KEY=""
OPENROUTER_VISION_MODEL=""

# Cloudflare Workers AI (vision, free tier 10k req/bulan)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_VISION_MODEL=""

# justDoWorker — relay AI gateway (New API) OpenAI-compatible. Opsional.
# Dipakai untuk vision (cari produk dari foto), normalisasi voice-to-text, dan
# fallback AI assistant chat. Kosongkan kalau tidak dipakai.
JUSTDOWORKER_API_KEY=""
JUSTDOWORKER_BASE_URL=""
JUSTDOWORKER_MODEL=""
JUSTDOWORKER_VISION_MODEL=""

# CORS (comma-separated frontend domains)
CORS_ORIGINS="http://localhost:3000"

# Xendit (payment gateway)
# Dapatkan di Xendit Dashboard → Settings → Developers → API Keys.
# Test/development: prefix `xnd_development_`. Production: `xnd_production_`.
XENDIT_SECRET_KEY="xnd_development_xxxxxxxxxxxxxxxx"
# Random string yang Anda set juga di Xendit Dashboard → Webhooks →
# Verification Token. Wajib supaya callback dari Xendit asli yang diproses.
XENDIT_WEBHOOK_TOKEN="generate-via-openssl-rand-hex-32"
# URL frontend tujuan redirect setelah customer bayar / batal di halaman Xendit.
XENDIT_CALLBACK_SUCCESS_URL="http://localhost:3000/payment/success"
XENDIT_CALLBACK_FAILURE_URL="http://localhost:3000/payment/failure"
# Durasi invoice valid (detik). 900 = 15 menit. Min Xendit = 60.
XENDIT_INVOICE_DURATION="900"
XENDIT_API_BASE="https://api.xendit.co"
# Dev/sandbox only — auto-flip charge ke PAID setelah delay tanpa
# benar-benar bayar di Xendit. Jangan set di production.
# XENDIT_DEV_AUTO_SUCCESS="true"
# XENDIT_DEV_AUTO_SUCCESS_DELAY_MS="2000"

# NOTE: Platform WhatsApp sender tidak lagi di-config via env. Dia di-lookup
# dari tabel `whatsapp_sessions` dengan companyId = `default-company-id`
# (hardcoded di RegisterService). Operator wajib scan QR session itu lewat
# halaman /whatsapp setelah login dengan akun yg companyId-nya sama.

# ─── wa-service (external WhatsApp gateway) ─────────────────────────
# Backend WhatsApp di-extract ke service `wa-service` yang jalan terpisah.
#
# Setup workflow (manual provisioning — minipos TIDAK pegang admin token):
#   1. Admin buka wa-service UI → Tenants → buat tenant baru untuk company ini
#      → catat tenantId + apiKey + webhookSecret dari modal credentials
#   2. Admin minipos POST ke /api/whatsapp-receipt/setup dengan ketiga value
#      tsb (sekali per company). Lihat WhatsappReceiptController.setup.
#   3. Setelah setup, semua endpoint /whatsapp-receipt/* + webhook handler
#      otomatis jalan untuk company tsb.
#
# - WA_SERVICE_URL          : base URL wa-service backend
# - WA_SERVICE_WEBHOOK_BASE : URL public minipos sendiri — wa-service akan
#                             POST INBOUND_MESSAGE + SESSION_UPDATED ke
#                             ${WA_SERVICE_WEBHOOK_BASE}/api/whatsapp/webhook/*.
#                             Wajib reachable dari wa-service.
WA_SERVICE_URL=https://wa-service-1018591685581.asia-southeast2.run.app
# Production minipos: pakai pos-api Cloud Run URL.
# Dev lokal: pakai ngrok / cloudflared tunnel — Cloud Run wa-service tidak
# bisa POST webhook ke localhost.
WA_SERVICE_WEBHOOK_BASE=https://pos-api-ua5mcqoolq-et.a.run.app

# Cloud Run
PORT=8080
NODE_ENV=production

# ── Sentry (error monitoring backend) ──────────────────────────────────
SENTRY_DSN=

# ── Search-by-Image: ai-service (embedding) + pgvector ────────────────
# ai-service = FastAPI + SigLIP, ada di ./ai-service.
# Lokal: `docker compose up -d ai-service` lalu URL di bawah dipakai apa adanya
# (backend tetap jalan di host lewat `pnpm dev`).
AI_SERVICE_URL=http://localhost:8000

# Bearer token untuk /embed. Kosong = auth dilewati; itu HANYA aman kalau
# service listen di loopback (seperti docker-compose lokal). Di deployment
# WAJIB diisi dan nilainya harus sama dengan AI_SERVICE_TOKEN di ai-service.
AI_SERVICE_TOKEN=

# Model image encoder. Harus SAMA dengan yang di-bake ke image ai-service —
# vektor dari model berbeda tidak sebanding.
AI_MODEL_NAME=google/siglip-base-patch16-224

# Dimensi vektor. Harus SAMA dengan kolom products.embedding (vector(768))
# dan dengan /health.dim ai-service. SigLIP base = 768; CLIP ViT-B/32 = 512
# (kalau ganti ke CLIP, kolom DB harus di-recreate).
VECTOR_DIMENSION=768

# Jumlah maksimum hasil per pencarian foto.
IMAGE_SEARCH_LIMIT=12

# ── Ambang penerimaan hasil (lihat src/modules/image-search/image-search.gate.ts)
# Gate utamanya RELATIF, bukan absolut: hit diterima kalau jaraknya jauh lebih
# kecil dari sebaran jarak query itu sendiri.
#   ratio = distance / median(jarak query ke SELURUH katalog company)
# Terukur pada katalog 68 produk + 8 foto produk company lain:
#   ada di katalog     -> ratio 0.185 & 0.466
#   tidak ada          -> ratio 0.732 .. 0.876
# 0.60 = titik tengah kedua sebaran itu.
IMAGE_SEARCH_RATIO_MAX=0.60

# Plafon absolut: menahan gate kalau median sangat tinggi (foto yang asing bagi
# seluruh katalog). Jarak di atas ini tidak pernah diterima.
IMAGE_SEARCH_ABS_MAX=0.45

# Lantai absolut: jarak di bawah ini SELALU diterima, menahan gate kalau katalog
# penuh produk yang mirip satu sama lain sehingga median jadi kecil. 0.18 di atas
# p90 self-distance foto terdistorsi (0.14).
IMAGE_SEARCH_ABS_FLOOR=0.18

# Jumlah kandidat "Gambar serupa" yang tetap dikembalikan kalau TIDAK ADA hasil
# yang lolos gate. Gate dikalibrasi untuk kecocokan PRODUK, jadi foto kategori
# (mis. botol air mineral generik tanpa label sementara katalog hanya punya
# "Aqua Gelas") pasti gagal gate — tanpa tier ini user hanya melihat "tidak ada
# di katalog" padahal tetangga terdekatnya justru yang dia cari. Hasilnya HANYA
# mengisi section "Gambar serupa", tidak pernah diklaim persis.
# 0 = matikan (perilaku lama: gagal gate = nol hasil).
IMAGE_SEARCH_NEAR_LIMIT=6

# ── Jalur TEKS (text tower SigLIP → embedding FOTO produk)
# Dipakai sebagai jaring terakhir: deskripsi yang dibaca LLM vision dari foto
# dicocokkan ke FOTO produk, bukan ke nama produk. Ini menutup kasus nyata
# "foto botol air mineral tanpa label" vs katalog yang hanya punya "aqua gelas":
#   gambar→gambar : aqua gelas peringkat 40/69 (d=0.4366) — tidak ketemu
#   nama produk   : skor 0.031 (ambang 0.30)              — tidak ketemu
#   teks→gambar   : aqua gelas peringkat 1/69 (d=0.9284)  — KETEMU
# SKALA JARAKNYA BEDA dari gambar↔gambar, jangan pakai ambang di atas.
# Kalibrasi 13 deskripsi positif + 9 negatif pada katalog 69 produk:
#   ada padanannya -> d1 0.8596 .. 0.9284
#   tidak ada      -> d1 0.9605 .. 1.0081
# 0.945 = titik tengah kedua sebaran (terpisah bersih, jurang 0.032).
IMAGE_SEARCH_TEXT_ABS_MAX=0.945

# Jumlah maksimum hasil jalur teks. Kecil karena ini saran, bukan klaim cocok.
IMAGE_SEARCH_TEXT_LIMIT=6

# Batas ukuran gambar yang diterima (MB). Body limit di main.ts = 5mb.
IMAGE_MAX_SIZE_MB=5

# Timeout HTTP backend → ai-service. Cold start container model bisa lambat.
AI_SERVICE_TIMEOUT_MS=20000

# Cron sweeper embedding yang tertinggal (setiap 30 menit). "false" = matikan.
EMBEDDING_SWEEP_ENABLED=true
EMBEDDING_SWEEP_BATCH=16

