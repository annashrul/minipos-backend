# Database (Supabase / Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT
JWT_SECRET="generate-via-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# Redis (optional)
REDIS_URL=""

# Cloudinary (uploads)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Pusher (realtime, optional)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Resend (email, optional)
RESEND_API_KEY=""

# Groq AI (optional)
GROQ_API_KEY=""

# CORS (comma-separated frontend domains)
CORS_ORIGINS="http://localhost:3000"

# Cloud Run
PORT=8080
NODE_ENV=production
